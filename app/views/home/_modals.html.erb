<!-- Modals Wrapper -->
<div>

  <!-- Europass Modal -->
  <div data-modal-target="europassModal" data-action="click->modal#closeOutside" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/85 backdrop-blur-md overflow-y-auto animate-fade-in print:bg-white print:p-0">
    <div class="relative w-full max-w-4xl bg-white text-neutral-900 rounded-2xl shadow-2xl overflow-hidden my-auto max-h-[92vh] flex flex-col font-sans print:max-h-none print:shadow-none print:w-full print:max-w-none print:rounded-none">
      <!-- Modal Toolbar -->
      <div class="p-4 bg-[#0B0D10] text-white flex items-center justify-between print:hidden border-b border-white/10">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#003CA5] text-white flex items-center justify-center font-mono font-bold text-sm">EU</div>
          <div>
            <span class="font-mono text-xs text-[#003CA5] font-bold block">EUROPASS CURRICULUM VITAE STANDARD</span>
            <span class="text-xs text-neutral-400">Yorrany Braga - Product Designer & Architect</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button data-action="click->modal#printEuropass" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-[#003CA5] hover:bg-[#002361] text-white font-mono text-xs font-bold transition-all shadow-md">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
            <span>Print / Save as PDF</span>
          </button>
          <button data-action="click->modal#closeEuropass" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-neutral-300 hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
      </div>

      <!-- Printable Europass Document Body -->
      <div class="p-8 sm:p-12 overflow-y-auto space-y-8 bg-white text-neutral-800 text-sm leading-relaxed" id="europass-cv-document">
        <div class="border-b-2 border-neutral-900 pb-5">
          <div class="flex flex-col sm:flex-row justify-between items-start gap-4">
            <div class="flex-1 min-w-0">
              <h1 class="text-3xl font-black tracking-tight text-neutral-900 truncate">YORRANY BRAGA</h1>
              <p class="text-base font-semibold text-[#003CA5] mt-1 truncate">Principal Product Designer & Front-End Architect</p>
            </div>
            <div class="text-xs font-mono text-neutral-600 space-y-1 sm:text-right border-l-2 sm:border-l-0 sm:border-r-2 border-[#003CA5] pl-3 sm:pl-0 sm:pr-3 flex-shrink-0">
              <div class="whitespace-nowrap">Email: yorranymb@gmail.com</div>
              <div class="whitespace-nowrap">Tel / WA: +55 92 98414-3818</div>
              <div class="whitespace-nowrap">Location: Open to Relocation (Spain 🇪🇸 / Portugal 🇵🇹)</div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200">
            <div class="flex justify-between items-center w-full text-[9px] sm:text-[10px] font-semibold text-neutral-600 whitespace-nowrap tracking-tight">
              <span><span class="text-[#003CA5] uppercase tracking-normal">Credentials:</span> B.Sc. in Psychology <span class="text-neutral-400 font-normal">(human behaviour)</span></span>
              <span class="text-neutral-300 mx-1">•</span>
              <span>Front-End Architecture, Python &amp; JS Security <span class="text-neutral-400 font-normal">(The Linux Foundation)</span></span>
              <span class="text-neutral-300 mx-1">•</span>
              <span><span class="text-[#003CA5] uppercase tracking-normal">Focus:</span> digital health, e-commerce, design systems</span>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#003CA5] mb-2 border-b border-neutral-200 pb-1">Personal Statement & Professional Profile</h2>
          <p class="text-xs text-neutral-700 leading-relaxed">Product designer with 20 years of experience (2006–2026), bridging visual precision, cognitive psychology, brand strategy, and software engineering. B.Sc. in Psychology (Faculdade Santa Teresa) with published research on human behavior. Certified in Python (Instituto Superior Técnico) and JavaScript Security (The Linux Foundation). Specialized in building 0-to-1 digital health platforms, design systems, and high-conversion e-commerce infrastructures. Fully prepared for EU relocation or remote roles.</p>
        </div>

        <div>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#003CA5] mb-4 border-b border-neutral-200 pb-1">Work Experience (2006 - 2026)</h2>
          <div class="space-y-6">
            <% @experiences.each do |exp| %>
              <div class="border-l-2 border-neutral-200 pl-4 py-0.5">
                <div class="flex justify-between items-start text-xs font-mono mb-1">
                  <span class="font-bold text-neutral-900"><%= exp.role %></span>
                  <span class="text-[#003CA5] font-bold"><%= exp.period %></span>
                </div>
                <div class="text-xs font-semibold text-neutral-600 mb-2"><%= exp.company %> - <%= exp.location %></div>
                <p class="text-xs text-neutral-700 mb-2"><%= exp.summary %></p>
                <ul class="list-disc list-inside text-[11px] text-neutral-600 space-y-0.5">
                  <% (exp.highlights || "").split('||').each do |h| %>
                    <li><%= h.strip %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#003CA5] mb-3 border-b border-neutral-200 pb-1">Education & Academic Degree</h2>
          <div class="space-y-4">
            <% if @academic_bgs.present? %>
              <% @academic_bgs.each do |bg| %>
                <div class="border-l-2 border-neutral-200 pl-4">
                  <div class="font-bold text-xs text-neutral-900"><%= bg.degree %></div>
                  <div class="text-xs text-neutral-600"><%= bg.institution %></div>
                  <% if bg.thesis.present? %>
                    <div class="text-[11px] text-neutral-500 mt-1">Thesis: "<%= bg.thesis %>"</div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#003CA5] mb-3 border-b border-neutral-200 pb-1">Certifications & Technical Credentials</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
            <% @certifications.each do |c| %>
              <div class="p-2.5 bg-neutral-50 rounded border border-neutral-200">
                <div class="font-bold text-neutral-900"><%= c.title %></div>
                <div class="text-[11px] text-neutral-600"><%= c.issuer %> (<%= c.year %>)</div>
                <div class="text-[10px] text-[#003CA5] mt-1"><%= c.badge_code %></div>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#003CA5] mb-3 border-b border-neutral-200 pb-1">Language & Digital Competences</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
            <div class="p-2.5 bg-neutral-50 rounded border border-neutral-200">
              <div class="font-bold text-neutral-900">Portuguese</div>
              <div class="text-neutral-600">Mother tongue (C2)</div>
            </div>
            <div class="p-2.5 bg-neutral-50 rounded border border-neutral-200">
              <div class="font-bold text-neutral-900">Spanish</div>
              <div class="text-neutral-600">Working Comprehension (A1)</div>
            </div>
            <div class="p-2.5 bg-neutral-50 rounded border border-neutral-200">
              <div class="font-bold text-neutral-900">English</div>
              <div class="text-neutral-600">Technical / Professional (A1)</div>
            </div>
          </div>
        </div>

        <div class="text-center pt-6 border-t border-neutral-200 text-[10px] font-mono text-neutral-400">
          Official Europass Format - Yorrany Braga (yorrany.com.br)
        </div>
      </div>
    </div>
  </div>


  <!-- Case Study Modal Wrapper -->
  <div data-modal-target="caseStudyModal" data-action="click->modal#closeOutside" class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 md:p-6 lg:p-8 bg-black/85 backdrop-blur-md overflow-y-auto animate-fade-in print:hidden">
    <div class="relative w-full max-w-5xl bg-white dark:bg-[#13171F] text-brand-tinta dark:text-white border border-neutral-200 dark:border-white/10 rounded-2xl sm:rounded-3xl shadow-2xl overflow-hidden my-auto max-h-[94vh] flex flex-col transition-colors duration-300">
      <% @case_studies.each do |case_study| %>
        <div class="case-study-content hidden h-full flex flex-col overflow-hidden" data-id="<%= case_study.id %>">
          
          <!-- Modal Header -->
          <div class="p-5 sm:p-7 bg-[#F8FAFC] dark:bg-[#0B0D10] border-b border-neutral-200 dark:border-white/10 flex items-start justify-between gap-4 shrink-0">
            <div>
              <div class="flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] mb-1.5 font-bold">
                <span><%= case_study.period %></span>
                <span>•</span>
                <span><%= case_study.client %></span>
              </div>
              <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-neutral-900 dark:text-white tracking-tight"><%= case_study.title %></h2>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-mono mt-0.5"><%= case_study.role %></p>
            </div>
            <button data-action="click->modal#closeCase" class="p-2.5 rounded-full bg-neutral-200/80 hover:bg-neutral-300 dark:bg-[#13171F] dark:hover:bg-white/10 border border-neutral-300 dark:border-white/10 text-neutral-700 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-all shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>

          <!-- Barra de Navegação por Âncoras -->
          <div class="flex items-center gap-2 px-5 sm:px-7 py-3 bg-neutral-100/90 dark:bg-[#0B0D10]/90 backdrop-blur-md border-b border-neutral-200 dark:border-white/5 overflow-x-auto text-xs font-mono shrink-0">
            <button data-action="click->modal#scrollToSection" data-target-id="section-overview-<%= case_study.id %>" class="px-3.5 py-1.5 rounded-lg font-semibold bg-[#003CA5] text-white hover:bg-[#002361] shadow-sm transition-all whitespace-nowrap">
              <%= t('case_modal.tab_overview', default: '1. Visão Geral') %>
            </button>
            <button data-action="click->modal#scrollToSection" data-target-id="section-challenge-<%= case_study.id %>" class="px-3.5 py-1.5 rounded-lg font-semibold bg-white dark:bg-[#13171F] text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-white/10 border border-neutral-300 dark:border-white/10 shadow-sm transition-all whitespace-nowrap">
              <%= t('case_modal.tab_challenge_solution', default: '2. Desafio & Solução') %>
            </button>
            <button data-action="click->modal#scrollToSection" data-target-id="section-strategy-<%= case_study.id %>" class="px-3.5 py-1.5 rounded-lg font-semibold bg-white dark:bg-[#13171F] text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-white/10 border border-neutral-300 dark:border-white/10 shadow-sm transition-all whitespace-nowrap">
              <%= t('case_modal.tab_strategy', default: '3. Estratégia & Psicologia') %>
            </button>
            <% if case_study.gallery_images.attached? %>
              <button data-action="click->modal#scrollToSection" data-target-id="section-gallery-<%= case_study.id %>" class="px-3.5 py-1.5 rounded-lg font-semibold bg-white dark:bg-[#13171F] text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-white/10 border border-neutral-300 dark:border-white/10 shadow-sm transition-all whitespace-nowrap">
                <%= t('case_modal.tab_gallery', default: '4. Galeria de Telas') %> (<%= case_study.gallery_images.count %>)
              </button>
            <% end %>
          </div>

          <!-- Corpo do Modal com Scroll Unificado -->
          <div class="modal-scroll-area p-4 sm:p-7 md:p-8 overflow-y-auto space-y-8 sm:space-y-10 flex-1 bg-white dark:bg-[#13171F] text-neutral-800 dark:text-neutral-200">
            
            <!-- 1. SEÇÃO: VISÃO GERAL & CAPA (LARGURA TOTAL ESTILO BEHANCE) -->
            <div id="section-overview-<%= case_study.id %>" class="space-y-6 scroll-mt-4">
              <!-- Imagem de Capa em Largura Total -->
              <% if case_study.image.attached? %>
                <div class="w-full rounded-2xl overflow-hidden border border-neutral-200 dark:border-white/10 bg-neutral-100 dark:bg-[#07090C] shadow-lg">
                  <%= image_tag case_study.image, class: "w-full h-auto block object-cover", loading: "lazy" %>
                </div>
              <% end %>

              <!-- Tagline & Tags -->
              <% if case_study.tagline.present? %>
                <div class="text-base sm:text-lg md:text-xl font-semibold text-[#003CA5] dark:text-[#5B8EFF] leading-snug">
                  <%= case_study.tagline %>
                </div>
              <% end %>

              <div class="flex flex-wrap gap-2">
                <% (case_study.tags || "").split(',').each do |tag| %>
                  <span class="px-3 py-1 rounded-lg bg-neutral-100 dark:bg-[#0B0D10] text-xs font-mono text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-white/10">
                    <%= tag.strip %>
                  </span>
                <% end %>
              </div>

              <!-- Narrativa do Projeto -->
              <div class="bg-neutral-50 dark:bg-[#0B0D10] p-5 sm:p-7 rounded-2xl border border-neutral-200 dark:border-white/5">
                <h3 class="text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase font-bold tracking-wider mb-3">
                  <%= t('case_modal.executive_narrative', default: 'Narrativa do Projeto & Resumo Executivo') %>
                </h3>
                <p class="text-sm sm:text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
                  <%= case_study.full_description.presence || case_study.summary %>
                </p>
              </div>
            </div>

            <!-- 2. SEÇÃO: DESAFIO & SOLUÇÃO -->
            <div id="section-challenge-<%= case_study.id %>" class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 scroll-mt-4">
              <div class="bg-red-50/70 dark:bg-[#0B0D10] p-5 sm:p-7 rounded-2xl border border-red-200 dark:border-red-500/20">
                <div class="flex items-center gap-2 mb-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                  <h3 class="text-xs font-mono text-red-600 dark:text-red-400 uppercase font-bold tracking-wider">
                    <%= t('case_modal.the_challenge', default: 'O Desafio') %>
                  </h3>
                </div>
                <p class="text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
                  <%= case_study.challenge %>
                </p>
              </div>

              <div class="bg-emerald-50/70 dark:bg-[#0B0D10] p-5 sm:p-7 rounded-2xl border border-emerald-200 dark:border-emerald-500/20">
                <div class="flex items-center gap-2 mb-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                  <h3 class="text-xs font-mono text-emerald-600 dark:text-emerald-400 uppercase font-bold tracking-wider">
                    <%= t('case_modal.the_solution', default: 'A Solução') %>
                  </h3>
                </div>
                <p class="text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
                  <%= case_study.solution %>
                </p>
              </div>
            </div>

            <!-- 3. SEÇÃO: ESTRATÉGIA & BEHAVIORAL INSIGHT -->
            <div id="section-strategy-<%= case_study.id %>" class="scroll-mt-4">
              <div class="bg-purple-50/70 dark:bg-[#0B0D10] p-5 sm:p-7 rounded-2xl border border-purple-200 dark:border-purple-500/20">
                <div class="flex items-center gap-3 mb-4">
                  <svg class="w-5 h-5 text-purple-600 dark:text-purple-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
                  <h3 class="text-sm font-mono font-bold text-purple-700 dark:text-purple-300 uppercase tracking-wider">
                    <%= t('case_modal.behavioral_title', default: 'Psicologia Cognitiva & Behavioral Architecture') %>
                  </h3>
                </div>
                <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
                  <%= case_study.behavioral_insight %>
                </p>
              </div>
            </div>

            <!-- 4. SEÇÃO: GALERIA COMPLETA DE TELAS (FEED CONTÍNUO LARGURA TOTAL BEHANCE) -->
            <% if case_study.gallery_images.attached? %>
              <div id="section-gallery-<%= case_study.id %>" class="space-y-6 scroll-mt-4 pt-4 border-t border-neutral-200 dark:border-white/10">
                <div class="flex items-center justify-between">
                  <h3 class="text-base sm:text-lg md:text-xl font-bold text-neutral-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#003CA5] dark:text-[#5B8EFF] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <%= t('case_modal.gallery_title', default: 'Galeria Completa de Telas & Processo') %>
                  </h3>
                  <span class="text-xs font-mono text-neutral-500">
                    <%= case_study.gallery_images.count %> <%= t('case_modal.images_count', default: 'imagens') %>
                  </span>
                </div>

                <!-- Feed contínuo de lâminas em largura total -->
                <div class="flex flex-col gap-6 sm:gap-8">
                  <% case_study.gallery_images.each do |img| %>
                    <div class="w-full rounded-2xl overflow-hidden border border-neutral-200 dark:border-white/10 bg-neutral-100 dark:bg-[#07090C] shadow-md hover:shadow-xl transition-all">
                      <%= image_tag img, class: "w-full h-auto block object-cover", loading: "lazy" %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

          </div>
          
        </div>
      <% end %>
    </div>
  </div>

  <!-- Cert Modal Wrapper -->
  <div data-modal-target="certModal" data-action="click->modal#closeOutside" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 md:p-10 bg-black/80 backdrop-blur-md overflow-y-auto animate-fade-in print:hidden">
    <div class="relative w-full lg:w-auto lg:min-w-[50vw] max-w-6xl bg-[#13171F] border border-white/10 rounded-3xl shadow-2xl overflow-hidden my-auto flex flex-col">
      <div class="p-6 sm:p-8 bg-[#0B0D10] border-b border-white/10 flex items-center justify-between gap-4 sticky top-0 z-20">
        <h2 id="cert-modal-title" class="text-xl sm:text-2xl font-extrabold text-white tracking-tight truncate flex-1">Documento</h2>
        
        <div id="cert-modal-credential-container" class="hidden items-center gap-3 md:gap-4 shrink-0">
          <div id="cert-modal-code-wrapper" class="flex items-center gap-2 bg-[#1A1F2B] border border-white/10 rounded-lg p-1 pr-3">
            <button data-action="click->modal#copyCredential" id="cert-modal-copy-btn" class="p-1.5 rounded-md hover:bg-white/10 text-neutral-400 hover:text-white transition-colors" title="Copiar código">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            </button>
            <span id="cert-modal-credential-code" class="text-[10px] sm:text-xs font-mono text-emerald-400"></span>
          </div>
          <a id="cert-modal-credential-url" href="#" target="_blank" rel="noopener noreferrer" class="hidden text-[10px] sm:text-xs font-bold text-white bg-[#003CA5] hover:bg-[#003CA5]/90 px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg transition-colors shadow-lg shadow-[#003CA5]/20 items-center gap-2">
            Verificar <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
        <button data-action="click->modal#closeCert" class="p-2.5 rounded-full bg-[#13171F] hover:bg-white/10 border border-white/10 text-neutral-400 hover:text-white transition-all shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="p-4 sm:p-6 overflow-y-auto bg-[#13171F] flex items-center justify-center">
        <div id="cert-modal-content" class="w-full flex items-center justify-center"></div>
      </div>
    </div>
  </div>

</div>
