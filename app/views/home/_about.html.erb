<!-- About & Philosophy Section (Visual Editorial Storytelling) -->
<section id="about" class="py-20 md:py-32 bg-brand-surface dark:bg-brand-dark-surface relative w-full border-t border-brand-tinta/5 dark:border-white/5" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Photo Column with Floating Glass Badges (5 Cols on MD) -->
      <div class="md:col-span-5 relative" data-reveal-target="item">
        <div class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl border border-brand-tinta/10 dark:border-white/10 bg-neutral-900 group" data-controller="tilt">
          <%= image_tag 'yorrany.png', alt: 'Yorrany Braga', class: 'object-cover absolute inset-0 w-full h-full grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700' %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          
          <div class="absolute bottom-6 inset-x-6 text-white">
            <h3 class="text-xl font-bold font-serif">Yorrany Braga</h3>
            <p class="text-xs font-mono text-neutral-300">Principal Product Designer &amp; Front-End Architect</p>
          </div>
        </div>

        <!-- Floating Badge 1 -->
        <div class="absolute -top-4 -right-4 hidden sm:flex items-center gap-2 p-3 rounded-2xl glass-panel shadow-xl animate-float-slow text-xs font-mono font-bold text-neutral-800 dark:text-white">
          <span>🧠</span>
          <span>Psicologia &amp; Decisão</span>
        </div>

        <!-- Floating Badge 2 -->
        <div class="absolute -bottom-4 -left-4 hidden sm:flex items-center gap-2 p-3 rounded-2xl glass-panel shadow-xl animate-float-delayed text-xs font-mono font-bold text-[#003CA5] dark:text-[#5B8EFF]">
          <span>⚡</span>
          <span>20+ Anos de Carreira</span>
        </div>
      </div>

      <!-- Editorial Narrative Column (7 Cols on MD) -->
      <div class="md:col-span-7 flex flex-col justify-center space-y-6" data-reveal-target="item">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold">
          <span>✦</span>
          <span>Filosofia &amp; Trajetória</span>
        </div>

        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-brand-titulos dark:text-white leading-[1.15] font-serif">
          <%= t('about.h2') %>
        </h2>
        
        <!-- 3 High-Impact Bite-Sized Credos -->
        <div class="space-y-4 pt-2">
          <div class="p-4 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/5 dark:border-white/5 flex items-start gap-4">
            <span class="w-8 h-8 rounded-xl bg-[#003CA5]/10 text-[#003CA5] dark:text-[#5B8EFF] font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
              01
            </span>
            <div>
              <h3 class="text-sm font-bold text-brand-tinta dark:text-white mb-1">Rigor Visual &amp; Tipografia</h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Origens no design gráfico editorial e precisão milimétrica suíça. Onde cada espaçamento e hierarquia tem propósito.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/5 dark:border-white/5 flex items-start gap-4">
            <span class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
              02
            </span>
            <div>
              <h3 class="text-sm font-bold text-brand-tinta dark:text-white mb-1">Psicologia da Escolha Humana</h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Licenciado em Psicologia para decifrar a tomada de decisão, reduzindo a fricção e gerando conversões éticas e previsíveis.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/5 dark:border-white/5 flex items-start gap-4">
            <span class="w-8 h-8 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
              03
            </span>
            <div>
              <h3 class="text-sm font-bold text-brand-tinta dark:text-white mb-1">Arquitetura de Front-End &amp; Segurança</h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Certificado pela Linux Foundation. Código pronto para produção, acessibilidade WCAG AAA e zero atrito com engenheiros.
              </p>
            </div>
          </div>
        </div>

      </div>
      
    </div>
  </div>
</section>

<!-- Europe Block (Interactive Expansion Hub) -->
<section id="europe" class="py-20 md:py-28 bg-[#07090E] text-white relative w-full overflow-hidden" data-controller="reveal">
  <!-- Ambient glow -->
  <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-[#003CA5]/20 rounded-full blur-[140px] pointer-events-none"></div>
  
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10" data-reveal-target="item">
    
    <!-- Relógio ao vivo de fusos europeus -->
    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/10 border border-white/15 backdrop-blur-md mb-8 shadow-sm">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-xs font-mono text-sky-300 font-bold uppercase tracking-wider">
        <%= t('europe.time_label', default: 'Lisboa (WET) · Madrid (CET)') %>
      </span>
      <span class="text-xs text-white/30">•</span>
      <span class="text-xs sm:text-sm font-mono text-white font-bold" data-controller="clock">--:--:--</span>
    </div>

    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-6 font-serif max-w-3xl mx-auto leading-tight">
      <%= t('europe.h2') %>
    </h2>
    
    <p class="text-sm sm:text-base text-neutral-300 max-w-2xl mx-auto leading-relaxed mb-10">
      <%= t('europe.desc') %>
    </p>

    <!-- Grid de Especificações e Destaques de Contratação -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 max-w-3xl mx-auto mb-10 text-left">
      <!-- Item 1: Fuso Horário -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-sky-400 font-bold block mb-1">Fuso Horário</span>
        <div class="text-xs sm:text-sm font-semibold text-white">WET / CET</div>
      </div>

      <!-- Item 2: Modelo de Trabalho -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-sky-400 font-bold block mb-1">Modelo</span>
        <div class="text-xs sm:text-sm font-semibold text-white">Remoto / Realocação</div>
      </div>

      <!-- Item 3: Elegibilidade & Vistos -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-sky-400 font-bold block mb-1">Elegibilidade</span>
        <div class="text-xs sm:text-sm font-semibold text-white">B2B / EOR / Sponsor</div>
      </div>

      <!-- Item 4: Idiomas -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-sky-400 font-bold block mb-1">Idiomas</span>
        <div class="text-xs sm:text-sm font-semibold text-white">PT (Nativo) · EN · ES</div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>" target="_blank" data-turbo="false" class="w-full sm:w-auto px-8 py-4 bg-[#003CA5] hover:bg-[#002361] text-white font-mono font-bold text-sm rounded-full transition-all shadow-xl shadow-[#003CA5]/30 hover:scale-[1.02] active:scale-[0.98]">
        <%= t('europe.cta_primary', default: 'Descarregar CV Oficial') %>
      </a>
      
      <a href="https://linkedin.com/in/yorrany" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-white/10 border border-white/20 hover:border-white hover:bg-white/15 text-white font-mono font-bold text-sm rounded-full transition-all hover:scale-[1.02] active:scale-[0.98]">
        <%= t('europe.cta_secondary', default: 'Conectar no LinkedIn') %>
      </a>
    </div>

  </div>
</section>
