<!-- About & Philosophy Section (Visual Editorial Storytelling) -->
<section id="about" class="py-20 md:py-32 bg-brand-surface dark:bg-brand-dark-surface relative w-full border-t border-brand-tinta/5 dark:border-white/5" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Photo Column with Deep Immersion & Atmospheric Lighting (5 Cols on MD) -->
      <div class="md:col-span-5 relative flex items-center justify-center" data-reveal-target="item">
        <!-- Ambient Backlight Glow -->
        <div class="absolute -inset-4 bg-gradient-to-tr from-[#003CA5]/25 via-[#3D33FF]/15 to-[#00A5FF]/20 rounded-3xl blur-2xl opacity-80 pointer-events-none"></div>

        <div class="relative w-full aspect-[3/4] sm:aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl border border-brand-tinta/10 dark:border-white/10 bg-neutral-950 group card-border-glow" data-controller="tilt">
          <%= image_tag 'yorrany.png', alt: 'Yorrany Braga', class: 'object-cover absolute inset-0 w-full h-full object-top group-hover:scale-105 transition-all duration-700 pointer-events-none' %>
          
          <!-- Cinematic Vignette & Ambient Color Gradients -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-tr from-[#003CA5]/20 via-transparent to-transparent mix-blend-overlay"></div>
          
          <!-- Top Floating Identity Tag -->
          <div class="absolute top-4 left-4 z-10">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-black/65 backdrop-blur-md text-white border border-white/15 text-xs font-semibold shadow-lg">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Yorrany Braga</span>
            </span>
          </div>

          <!-- Bottom Editorial Showcase Card -->
          <div class="absolute bottom-4 inset-x-4 z-10 text-white">
            <div class="p-4 rounded-2xl bg-black/50 backdrop-blur-md border border-white/15 shadow-xl">
              <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white leading-tight">Yorrany Braga</h3>
              <p class="text-xs text-sky-300 font-semibold mt-0.5">Principal Product Designer &amp; Front-End Architect</p>
              
              <div class="flex items-center gap-2.5 mt-2.5 pt-2.5 border-t border-white/15 text-[11px] text-neutral-300 font-medium">
                <span>✦ <%= t('about.career_highlight', default: '20+ Anos de Carreira') %></span>
                <span>•</span>
                <span><%= t('about.role_summary', default: 'Psicologia & Código') %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Editorial Narrative Column (7 Cols on MD) -->
      <div class="md:col-span-7 flex flex-col justify-center space-y-6" data-reveal-target="item">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold">
          <span>✦</span>
          <span><%= t('about.eyebrow', default: 'Filosofia & Trajetória') %></span>
        </div>

        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-brand-titulos dark:text-white leading-[1.12]">
          <%= t('about.h2') %>
        </h2>
        
        <!-- 3 High-Impact Bite-Sized Credos -->
        <div class="space-y-4 pt-2">
          <div class="p-5 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/5 dark:border-white/5 flex items-start gap-4">
            <span class="w-8 h-8 rounded-xl bg-[#003CA5]/10 text-[#003CA5] dark:text-[#5B8EFF] font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
              01
            </span>
            <div>
              <h3 class="text-base font-bold text-brand-tinta dark:text-white mb-1"><%= t('about.credo1_title', default: 'Rigor Visual & Tipografia') %></h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                <%= t('about.credo1_desc', default: 'Origens no design gráfico e na precisão milimétrica suíça. Onde cada espaçamento, proporção e hierarquia visual tem propósito estratégico.') %>
              </p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/5 dark:border-white/5 flex items-start gap-4">
            <span class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
              02
            </span>
            <div>
              <h3 class="text-base font-bold text-brand-tinta dark:text-white mb-1"><%= t('about.credo2_title', default: 'Psicologia da Escolha Humana') %></h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                <%= t('about.credo2_desc', default: 'Licenciado em Psicologia para decifrar a tomada de decisão, reduzindo a sobrecarga cognitiva e gerando conversões éticas e sustentáveis.') %>
              </p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/5 dark:border-white/5 flex items-start gap-4">
            <span class="w-8 h-8 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 font-mono font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
              03
            </span>
            <div>
              <h3 class="text-base font-bold text-brand-tinta dark:text-white mb-1"><%= t('about.credo3_title', default: 'Arquitetura de Front-End & Segurança') %></h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                <%= t('about.credo3_desc', default: 'Certificado pela Linux Foundation. Código limpo, componentes resilientes, acessibilidade WCAG AAA e zero fricção com os desenvolvedores.') %>
              </p>
            </div>
          </div>
        </div>

      </div>
      
    </div>
  </div>
</section>

<!-- Europe Block (Fully Themed for Light & Dark Mode) -->
<section id="europe" class="py-20 md:py-28 bg-brand-tint/30 dark:bg-[#07090E] text-brand-tinta dark:text-white relative w-full overflow-hidden border-t border-brand-tinta/5 dark:border-white/5" data-controller="reveal">
  <!-- Subtle Ambient glow -->
  <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-[#003CA5]/10 dark:bg-[#003CA5]/20 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute -left-20 -top-20 w-80 h-80 bg-[#00A5FF]/10 dark:bg-[#00A5FF]/15 rounded-full blur-[120px] pointer-events-none"></div>
  
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10" data-reveal-target="item">
    
    <!-- Live European Clock Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-brand-surface dark:bg-white/10 border border-brand-tinta/10 dark:border-white/15 shadow-sm mb-8 backdrop-blur-md">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-xs font-mono text-[#003CA5] dark:text-sky-300 font-bold uppercase tracking-wider">
        <%= t('europe.time_label', default: 'Lisboa (WET) · Madrid (CET)') %>
      </span>
      <span class="text-xs text-neutral-400 dark:text-white/30">•</span>
      <span class="text-xs sm:text-sm font-mono text-brand-tinta dark:text-white font-bold" data-controller="clock">--:--:--</span>
    </div>

    <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-brand-titulos dark:text-white mb-6 max-w-3xl mx-auto leading-tight">
      <%= t('europe.h2') %>
    </h2>
    
    <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto leading-relaxed mb-10">
      <%= t('europe.desc') %>
    </p>

    <!-- Grid de Especificações e Destaques de Contratação -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 max-w-3xl mx-auto mb-10 text-left">
      <!-- Item 1: Fuso Horário -->
      <div class="p-4 rounded-2xl bg-brand-surface dark:bg-white/5 border border-brand-tinta/10 dark:border-white/10 shadow-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[#003CA5] dark:text-sky-400 font-bold block mb-1">Fuso Horário</span>
        <div class="text-xs sm:text-sm font-semibold text-brand-tinta dark:text-white">WET / CET</div>
      </div>

      <!-- Item 2: Modelo de Trabalho -->
      <div class="p-4 rounded-2xl bg-brand-surface dark:bg-white/5 border border-brand-tinta/10 dark:border-white/10 shadow-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[#003CA5] dark:text-sky-400 font-bold block mb-1">Modelo</span>
        <div class="text-xs sm:text-sm font-semibold text-brand-tinta dark:text-white">Remoto / Realocação</div>
      </div>

      <!-- Item 3: Elegibilidade & Vistos -->
      <div class="p-4 rounded-2xl bg-brand-surface dark:bg-white/5 border border-brand-tinta/10 dark:border-white/10 shadow-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[#003CA5] dark:text-sky-400 font-bold block mb-1">Elegibilidade</span>
        <div class="text-xs sm:text-sm font-semibold text-brand-tinta dark:text-white">B2B / EOR / Sponsor</div>
      </div>

      <!-- Item 4: Idiomas -->
      <div class="p-4 rounded-2xl bg-brand-surface dark:bg-white/5 border border-brand-tinta/10 dark:border-white/10 shadow-sm hover:border-[#003CA5] transition-all">
        <span class="text-[10px] font-mono uppercase tracking-wider text-[#003CA5] dark:text-sky-400 font-bold block mb-1">Idiomas</span>
        <div class="text-xs sm:text-sm font-semibold text-brand-tinta dark:text-white">PT (Nativo) · EN · ES</div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>" target="_blank" data-turbo="false" class="w-full sm:w-auto px-8 py-4 bg-[#003CA5] hover:bg-[#002361] text-white font-mono font-bold text-sm rounded-full transition-all shadow-xl shadow-[#003CA5]/25 hover:scale-[1.02] active:scale-[0.98]">
        <%= t('europe.cta_primary', default: 'Descarregar CV Oficial') %>
      </a>
      
      <a href="https://linkedin.com/in/yorrany" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-brand-surface dark:bg-white/10 border border-brand-tinta/15 dark:border-white/20 hover:border-[#003CA5] dark:hover:border-white hover:bg-brand-tinta/5 dark:hover:bg-white/15 text-brand-tinta dark:text-white font-mono font-bold text-sm rounded-full transition-all hover:scale-[1.02] active:scale-[0.98]">
        <%= t('europe.cta_secondary', default: 'Conectar no LinkedIn') %>
      </a>
    </div>

  </div>
</section>
