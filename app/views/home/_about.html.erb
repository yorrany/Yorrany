<!-- About Section (Editorial Layout) -->
<section id="about" class="py-24 md:py-32 bg-brand-surface dark:bg-brand-dark-surface relative w-full">
  <div class="max-w-6xl mx-auto px-6 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-24 items-stretch">
      
      <!-- B&W Photo Column -->
      <div class="relative w-full aspect-[3/4] md:aspect-auto md:h-full bg-neutral-200 dark:bg-neutral-800 rounded-xl overflow-hidden shadow-2xl">
        <%= image_tag 'yorrany.png', alt: 'Yorrany Braga', class: 'object-cover absolute inset-0 w-full h-full grayscale' %>
      </div>

      <!-- Editorial Text Column -->
      <div class="space-y-6 flex flex-col justify-center py-4">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-brand-titulos dark:text-brand-dark-tinta leading-[1.15] mb-8 font-serif">
          <%= t('about.h2') %>
        </h2>
        
        <p class="text-brand-tinta/80 dark:text-brand-dark-tinta/80 text-lg leading-relaxed">
          <%= t('about.p1') %>
        </p>
        
        <p class="text-brand-tinta/80 dark:text-brand-dark-tinta/80 text-lg leading-relaxed">
          <%= t('about.p2') %>
        </p>
        
        <p class="text-brand-tinta/80 dark:text-brand-dark-tinta/80 text-lg leading-relaxed">
          <%= t('about.p3') %>
        </p>

        <div class="mt-8 pt-8 border-t border-brand-tinta/10 dark:border-white/10">
          <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold mb-4">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span><%= t('about.credentials_title', default: 'Credenciais & Especialidades') %></span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            <!-- Card 1: Comportamento Humano -->
            <div class="p-4 rounded-2xl bg-brand-fundo/70 dark:bg-[#0B0D10]/70 border border-brand-tinta/5 dark:border-white/5 flex flex-col justify-between hover:border-[#003CA5]/30 dark:hover:border-[#003CA5]/50 transition-all group">
              <div>
                <div class="text-[10px] font-mono text-neutral-500 dark:text-neutral-400 uppercase font-bold tracking-wider mb-1.5 flex items-center justify-between">
                  <span><%= t('about.cred_psych_label', default: 'Formação & Ciências') %></span>
                  <svg class="w-3 h-3 text-[#003CA5] dark:text-sky-400 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
                </div>
                <div class="text-xs sm:text-[13px] font-bold text-brand-tinta dark:text-white leading-snug">
                  <%= t('about.cred_psych_title', default: 'Licenciatura em Psicologia') %>
                </div>
              </div>
              <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-2 font-mono leading-tight">
                <%= t('about.cred_psych_desc', default: 'Comportamento humano & tomada de decisão') %>
              </div>
            </div>

            <!-- Card 2: Arquitetura Técnica & Segurança -->
            <div class="p-4 rounded-2xl bg-brand-fundo/70 dark:bg-[#0B0D10]/70 border border-brand-tinta/5 dark:border-white/5 flex flex-col justify-between hover:border-[#003CA5]/30 dark:hover:border-[#003CA5]/50 transition-all group">
              <div>
                <div class="text-[10px] font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase font-bold tracking-wider mb-1.5 flex items-center justify-between">
                  <span><%= t('about.cred_tech_label', default: 'Arquitetura & Segurança') %></span>
                  <svg class="w-3 h-3 text-[#003CA5] dark:text-[#5B8EFF] opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <div class="text-xs sm:text-[13px] font-bold text-brand-tinta dark:text-white leading-snug">
                  <%= t('about.cred_tech_title', default: 'Front-End, Python & JS Security') %>
                </div>
              </div>
              <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-2 font-mono leading-tight">
                <%= t('about.cred_tech_desc', default: 'The Linux Foundation') %>
              </div>
            </div>

            <!-- Card 3: Foco de Impacto & Domínio -->
            <div class="p-4 rounded-2xl bg-brand-fundo/70 dark:bg-[#0B0D10]/70 border border-brand-tinta/5 dark:border-white/5 flex flex-col justify-between hover:border-[#003CA5]/30 dark:hover:border-[#003CA5]/50 transition-all group">
              <div>
                <div class="text-[10px] font-mono text-neutral-500 dark:text-neutral-400 uppercase font-bold tracking-wider mb-1.5 flex items-center justify-between">
                  <span><%= t('about.cred_focus_label', default: 'Foco de Atuação') %></span>
                  <svg class="w-3 h-3 text-[#003CA5] dark:text-sky-400 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <div class="text-xs sm:text-[13px] font-bold text-brand-tinta dark:text-white leading-snug">
                  <%= t('about.cred_focus_title', default: 'Saúde Digital & E-Commerce') %>
                </div>
              </div>
              <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-2 font-mono leading-tight">
                <%= t('about.cred_focus_desc', default: 'Design Systems (0 → 1)') %>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- Europe Block (Fechamento) -->
<section id="europe" class="py-24 bg-brand-titulos text-white relative w-full overflow-hidden">
  <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none transform translate-x-1/4 translate-y-1/4">
    <svg width="400" height="400" viewBox="0 0 24 24" fill="var(--color-brand-acento)" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L2 22H22L12 2Z"/></svg>
  </div>
  
  <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center relative z-10">
    <!-- Relógio ao vivo -->
    <div class="inline-flex flex-wrap items-center justify-center gap-2.5 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8">
      <span class="inline-flex items-center gap-1.5 text-xs font-mono text-brand-acento uppercase tracking-wider font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <%= t('europe.time_label', default: 'Lisboa (WET) · Madrid (CET)') %>
      </span>
      <span class="text-xs text-white/30 hidden sm:inline">•</span>
      <span class="text-xs sm:text-sm font-mono text-white/90 font-medium" data-controller="clock">--:--:--</span>
    </div>

    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-6 font-serif">
      <%= t('europe.h2') %>
    </h2>
    
    <p class="text-base sm:text-lg text-white/80 max-w-2xl mx-auto leading-relaxed mb-10">
      <%= t('europe.desc') %>
    </p>

    <!-- Grid de Especificações e Destaques de Contratação -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3.5 max-w-3xl mx-auto mb-12 text-left">
      <!-- Item 1: Fuso Horário -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-brand-acento/40 transition-all group flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[10px] font-mono uppercase tracking-wider text-brand-acento font-bold"><%= t('europe.spec_tz_label') %></span>
          <svg class="w-3.5 h-3.5 text-brand-acento opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="text-xs sm:text-[13px] font-semibold text-white leading-snug">
          <%= t('europe.spec_tz_val') %>
        </div>
      </div>

      <!-- Item 2: Modelo de Trabalho -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-brand-acento/40 transition-all group flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[10px] font-mono uppercase tracking-wider text-brand-acento font-bold"><%= t('europe.spec_model_label') %></span>
          <svg class="w-3.5 h-3.5 text-brand-acento opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div class="text-xs sm:text-[13px] font-semibold text-white leading-snug">
          <%= t('europe.spec_model_val') %>
        </div>
      </div>

      <!-- Item 3: Elegibilidade & Vistos -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-brand-acento/40 transition-all group flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[10px] font-mono uppercase tracking-wider text-brand-acento font-bold"><%= t('europe.spec_eligibility_label') %></span>
          <svg class="w-3.5 h-3.5 text-brand-acento opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div class="text-xs sm:text-[13px] font-semibold text-white leading-snug">
          <%= t('europe.spec_eligibility_val') %>
        </div>
      </div>

      <!-- Item 4: Idiomas -->
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:border-brand-acento/40 transition-all group flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[10px] font-mono uppercase tracking-wider text-brand-acento font-bold"><%= t('europe.spec_languages_label') %></span>
          <svg class="w-3.5 h-3.5 text-brand-acento opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
        </div>
        <div class="text-xs sm:text-[13px] font-semibold text-white leading-snug">
          <%= t('europe.spec_languages_val') %>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>" target="_blank" data-turbo="false" class="w-full sm:w-auto px-8 py-4 bg-brand-acento hover:bg-brand-acento/80 text-brand-titulos font-bold text-base sm:text-lg rounded-full transition-all shadow-lg shadow-brand-acento/20 text-center hover:scale-[1.02] active:scale-[0.98]">
        <%= t('europe.cta_primary') %>
      </a>
      
      <a href="https://linkedin.com/in/yorrany" target="_blank" class="w-full sm:w-auto px-8 py-4 bg-transparent border-2 border-white/20 hover:border-brand-acento hover:bg-white/5 text-white font-medium text-base sm:text-lg rounded-full transition-all text-center hover:scale-[1.02] active:scale-[0.98]">
        <%= t('europe.cta_secondary') %>
      </a>
    </div>
  </div>
</section>
