<!-- Contact Footer -->
<footer id="contact" class="pt-20 pb-28 md:pb-16 bg-brand-fundo dark:bg-[#0B0D10] relative w-full border-t border-brand-tinta/5 dark:border-white/5" data-controller="contact-form reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Contact Header -->
    <div class="mb-14" data-reveal-target="item">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold mb-3">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        <span><%= t('contact.eyebrow', default: 'Contato Direto') %></span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-brand-tinta dark:text-white tracking-tight">
        <%= t('contact.title', default: 'Vamos conversar sobre oportunidades') %>
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base max-w-2xl mt-2">
        <%= t('contact.subtitle', default: 'Disponível para posições de liderança em Design System, Arquitetura de Produto ou consultoria remota e presencial na Europa.') %>
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-20">
      <!-- Direct Channels Column (5 cols on LG) -->
      <div class="lg:col-span-5 space-y-5 h-full flex flex-col justify-between" data-reveal-target="item">
        <!-- Email Card -->
        <div class="bg-brand-surface dark:bg-[#13171F] p-6 sm:p-7 rounded-3xl border border-brand-tinta/5 dark:border-white/5 hover:border-[#003CA5]/30 dark:hover:border-[#5B8EFF]/30 transition-all card-border-glow shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#003CA5] dark:text-[#5B8EFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              <%= t('contact.emailLabel', default: 'E-mail') %>
            </span>
            <button data-action="click->contact-form#copyEmail" data-contact-form-target="copyButton" class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-brand-fundo dark:bg-[#0B0D10] text-xs font-mono text-neutral-700 dark:text-neutral-300 hover:text-brand-tinta dark:hover:text-white border border-brand-tinta/5 dark:border-white/5 transition-all">
              <svg data-contact-form-target="copyIcon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              <svg data-contact-form-target="checkIcon" class="w-3.5 h-3.5 text-emerald-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span data-contact-form-target="copyText"><%= t('contact.copy', default: 'Copiar') %></span>
            </button>
          </div>

          <a href="mailto:falecom@yorrany.com.br" class="text-lg sm:text-xl font-bold text-brand-tinta dark:text-white hover:text-[#003CA5] dark:hover:text-[#5B8EFF] font-mono transition-colors block truncate">
            falecom@yorrany.com.br
          </a>
        </div>

        <!-- WhatsApp Card -->
        <div class="bg-brand-surface dark:bg-[#13171F] p-6 sm:p-7 rounded-3xl border border-brand-tinta/5 dark:border-white/5 hover:border-emerald-500/30 transition-all card-border-glow shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              <%= t('contact.whatsappLabel', default: 'Direct Contact') %>
            </span>
            <a href="https://wa.me/5592984143818?text=Hello%20Yorrany,%20I%20saw%20your%20portfolio%20at%20yorrany.com.br" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-brand-fundo dark:bg-[#0B0D10] text-xs font-mono text-emerald-500 hover:text-emerald-400 border border-brand-tinta/5 dark:border-white/5 transition-all">
              <span>WhatsApp</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>

          <div class="text-lg sm:text-xl font-bold text-brand-tinta dark:text-white font-mono">
            +55 92 98414-3818
          </div>
        </div>

        <!-- Social Links (Optimized Layout with Generous Visual Breathing Room & Pixel-Perfect SVGs) -->
        <div class="bg-brand-surface dark:bg-[#13171F] p-6 sm:p-7 rounded-3xl border border-brand-tinta/5 dark:border-white/5 space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 uppercase tracking-wider font-bold">
              <%= t('contact.profilesLabel', default: 'Perfis Profissionais') %>
            </span>
            <span class="text-[11px] font-mono text-neutral-400">Social</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/in/yorrany" target="_blank" rel="noopener noreferrer" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] hover:bg-white dark:hover:bg-white/[0.08] text-neutral-800 dark:text-neutral-200 border border-brand-tinta/10 dark:border-white/10 hover:border-[#0A66C2]/40 hover:shadow-md transition-all group">
              <div class="flex items-center justify-between mb-3">
                <div class="w-9 h-9 rounded-xl bg-[#0A66C2]/10 flex items-center justify-center text-[#0A66C2] group-hover:scale-110 group-hover:bg-[#0A66C2] group-hover:text-white transition-all shadow-xs">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64c-.87 0-1.58.7-1.58 1.57s.71 1.57 1.58 1.57 1.58-.7 1.58-1.57-.71-1.57-1.58-1.57z"/>
                  </svg>
                </div>
                <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:text-[#0A66C2] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </div>
              <div>
                <span class="text-xs font-bold font-sans text-brand-tinta dark:text-white block group-hover:text-[#0A66C2] transition-colors">LinkedIn</span>
                <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 truncate block">/in/yorrany</span>
              </div>
            </a>

            <!-- Behance -->
            <a href="https://www.behance.net/yorrany" target="_blank" rel="noopener noreferrer" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] hover:bg-white dark:hover:bg-white/[0.08] text-neutral-800 dark:text-neutral-200 border border-brand-tinta/10 dark:border-white/10 hover:border-[#0057FF]/40 hover:shadow-md transition-all group">
              <div class="flex items-center justify-between mb-3">
                <div class="w-9 h-9 rounded-xl bg-[#0057FF]/10 flex items-center justify-center text-[#0057FF] group-hover:scale-110 group-hover:bg-[#0057FF] group-hover:text-white transition-all shadow-xs">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 576 512">
                    <path d="M232 237.2c31.8-15.2 48.4-38.2 48.4-74 0-70.6-52.6-87.8-113.3-87.8H0v354.4h171.8c64.4 0 124.9-30.9 124.9-102.9 0-44.5-21.1-77.4-64.7-89.7zM77.9 135.9H151c28.1 0 53.4 7.9 53.4 40.5 0 30.1-19.7 42.2-47.5 42.2h-79v-82.7zm83.3 233.7H77.9V272h84.9c34.3 0 56 14.3 56 50.6 0 35.8-25.9 47-57.6 47zm358.5-240.7H376V94h143.7v34.9zM576 305.2c0-75.9-44.4-139.2-124.9-139.2-78.2 0-131.3 58.8-131.3 135.8 0 79.9 50.3 134.7 131.3 134.7 61.3 0 101-27.6 120.1-86.3H509c-6.7 21.9-34.3 33.5-55.7 33.5-41.3 0-63-24.2-63-65.3h185.1c.3-4.2.6-8.7.6-13.2zM390.4 274c2.3-33.7 24.7-54.8 58.5-54.8 35.4 0 53.2 20.8 56.2 54.8H390.4z"/>
                  </svg>
                </div>
                <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:text-[#0057FF] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </div>
              <div>
                <span class="text-xs font-bold font-sans text-brand-tinta dark:text-white block group-hover:text-[#0057FF] transition-colors">Behance</span>
                <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 truncate block">/yorrany</span>
              </div>
            </a>

            <!-- GitHub -->
            <a href="https://github.com/yorrany" target="_blank" rel="noopener noreferrer" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] hover:bg-white dark:hover:bg-white/[0.08] text-neutral-800 dark:text-neutral-200 border border-brand-tinta/10 dark:border-white/10 hover:border-neutral-900/40 dark:hover:border-white/40 hover:shadow-md transition-all group">
              <div class="flex items-center justify-between mb-3">
                <div class="w-9 h-9 rounded-xl bg-neutral-900/10 dark:bg-white/10 flex items-center justify-center text-neutral-900 dark:text-white group-hover:scale-110 group-hover:bg-neutral-900 group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-neutral-900 transition-all shadow-xs">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </div>
                <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </div>
              <div>
                <span class="text-xs font-bold font-sans text-brand-tinta dark:text-white block group-hover:text-neutral-900 dark:group-hover:text-white transition-colors">GitHub</span>
                <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 truncate block">/yorrany</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form Column -->
      <div class="lg:col-span-7 bg-brand-surface dark:bg-[#13171F] p-8 sm:p-10 rounded-3xl border border-brand-tinta/5 dark:border-white/5 card-border-glow flex flex-col" data-reveal-target="item">
        <h3 class="text-xl font-bold text-brand-tinta dark:text-white mb-6 flex items-center gap-2 shrink-0">
          <svg class="w-5 h-5 text-[#003CA5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
          <span><%= t('contact.sendInquiry', default: 'Send a Direct Inquiry') %></span>
        </h3>

        <!-- Success Message -->
        <div data-contact-form-target="successMessage" class="hidden p-6 bg-emerald-500/10 dark:bg-emerald-500/10 rounded-2xl border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-sm font-mono flex items-start gap-3 shrink-0">
          <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <div>
            <div class="font-bold text-brand-tinta dark:text-white mb-1"><%= t('contact.sentTitle', default: 'Mensagem transmitida!') %></div>
            <div><%= t('contact.sentSuccess', default: 'Obrigado pelo contacto. Responderei com a máxima brevidade.') %></div>
          </div>
        </div>

        <!-- Error Message -->
        <div data-contact-form-target="errorMessage" class="hidden p-4 bg-red-500/10 dark:bg-red-500/10 rounded-2xl border border-red-500/30 text-red-600 dark:text-red-400 text-sm font-mono flex items-start gap-3 shrink-0">
          <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div data-contact-form-target="errorText"><%= t('contact.errorGeneric', default: 'Ocorreu um erro ao enviar. Tente novamente.') %></div>
        </div>

        <!-- Form -->
        <form data-contact-form-target="form" data-action="submit->contact-form#submit" class="space-y-4 flex-1 flex flex-col">
          <!-- Honeypot anti-spam (invisível para humanos) -->
          <input type="text" name="nickname" data-contact-form-target="honeypotInput" tabindex="-1" autocomplete="off" class="hidden" style="display: none !important;" aria-hidden="true" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 shrink-0">
            <div>
              <input data-contact-form-target="nameInput" type="text" required placeholder="<%= t('contact.formName', default: 'Nome Completo') %>" class="w-full px-4 py-3 rounded-xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/10 dark:border-white/10 text-brand-tinta dark:text-white text-sm focus:outline-none focus:border-[#003CA5] transition-colors" />
            </div>

            <div>
              <input data-contact-form-target="emailInput" type="email" required placeholder="<%= t('contact.formEmail', default: 'E-mail Profissional') %>" class="w-full px-4 py-3 rounded-xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/10 dark:border-white/10 text-brand-tinta dark:text-white text-sm focus:outline-none focus:border-[#003CA5] transition-colors" />
            </div>
          </div>

          <div class="flex-1 flex flex-col relative">
            <textarea data-contact-form-target="messageInput" required placeholder="<%= t('contact.formMessage', default: 'Mensagem') %>" class="w-full h-full flex-1 min-h-[120px] px-4 py-3 rounded-xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/10 dark:border-white/10 text-brand-tinta dark:text-white text-sm focus:outline-none focus:border-[#003CA5] transition-colors resize-none"></textarea>
          </div>

          <button data-contact-form-target="submitButton" type="submit" class="w-full flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-[#003CA5] hover:bg-[#002361] disabled:opacity-50 disabled:cursor-not-allowed text-white font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-lg hover:shadow-[#003CA5]/25 group shrink-0 mt-2">
            <svg data-contact-form-target="spinner" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span data-contact-form-target="submitButtonText"><%= t('contact.sendBtn', default: 'Enviar mensagem') %></span>
          </button>
        </form>
      </div>
    </div>

    <!-- Footer Bottom GDPR Strip -->
    <div class="pt-8 border-t border-brand-tinta/5 dark:border-white/5 flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-neutral-500 dark:text-neutral-400 gap-4">
      <div class="flex items-center gap-3">
        <%= render 'shared/logo', custom_class: 'h-6 sm:h-7 w-auto text-[#003CA5] dark:text-white opacity-50 antialiased' %>
        <span>© <%= Time.current.year %> Yorrany Braga.</span>
      </div>
      <div>
        <a href="/privacy" class="hover:text-brand-tinta dark:hover:text-white transition-colors underline decoration-neutral-300 dark:decoration-neutral-700 underline-offset-4">
          <%= t('footer.privacy', default: 'Política de Privacidade') %>
        </a>
      </div>
    </div>
  </div>
</footer>
