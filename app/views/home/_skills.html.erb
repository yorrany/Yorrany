<%
  categories = [
    {
      title_key: "skills.cat_design",
      default_title: "Design de Produto & Sistemas",
      skills: [
        { name: "Figma & Design Tokens", years: 10, percent: 95, icon: "figma" },
        { name: "Design Systems (0 → 1)", years: 12, percent: 98, icon: "system" },
        { name: "Adobe Creative Cloud", years: 18, percent: 100, icon: "adobe" },
        { name: "Prototipagem & Microinterações", years: 10, percent: 92, icon: "prototype" }
      ]
    },
    {
      title_key: "skills.cat_eng",
      default_title: "Engenharia Front-End & Código",
      skills: [
        { name: "Tailwind CSS & Tokens", years: 6, percent: 96, icon: "tailwind" },
        { name: "TypeScript & JavaScript", years: 12, percent: 94, icon: "js" },
        { name: "Ruby on Rails & Hotwire", years: 8, percent: 90, icon: "rails" },
        { name: "React & Next.js", years: 7, percent: 88, icon: "react" }
      ]
    },
    {
      title_key: "skills.cat_science",
      default_title: "Ciência Comportamental & Segurança",
      skills: [
        { name: "Psicologia Cognitiva & IHC", years: 8, percent: 95, icon: "brain" },
        { name: "WCAG & Acessibilidade AAA", years: 10, percent: 96, icon: "wcag" },
        { name: "Linux & JS Security (Linux Foundation)", years: 6, percent: 88, icon: "security" },
        { name: "Python & Automação de Dados", years: 5, percent: 85, icon: "python" }
      ]
    }
  ]
%>

<!-- Software Stack & Tools (With Visual Mastery Bars & Icons) -->
<section class="py-16 md:py-24 bg-brand-surface dark:bg-[#0B0D10] w-full border-t border-brand-tinta/5 dark:border-white/5" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12" data-reveal-target="item">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold mb-2">
        <span>✦</span>
        <span><%= t('skills.eyebrow', default: 'Ferramentas & Stack') %></span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight">
        <%= t('skills.title', default: 'Ferramentas do Ofício & Especialização') %>
      </h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">
        <%= t('skills.subtitle', default: 'Competências técnicas consolidadas e aplicadas em escala ao longo de duas décadas.') %>
      </p>
    </div>

    <!-- 3-Column Categorized Stack Grid with Evolution Bars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      <% categories.each do |cat| %>
        <div class="p-6 sm:p-7 rounded-3xl bg-brand-fundo dark:bg-[#13171F] border border-brand-tinta/10 dark:border-white/10 flex flex-col justify-between shadow-sm card-border-glow" data-reveal-target="item">
          <div>
            <h3 class="text-xs font-bold font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-wider mb-5 pb-3 border-b border-brand-tinta/10 dark:border-white/10 flex items-center justify-between">
              <span><%= t(cat[:title_key], default: cat[:default_title]) %></span>
              <span class="text-[10px] text-neutral-400 font-normal"><%= t('skills.mastery', default: 'Domínio') %></span>
            </h3>

            <div class="space-y-4">
              <% cat[:skills].each do |skill| %>
                <div class="space-y-1.5">
                  <div class="flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                      <!-- Skill Icon / Glyph -->
                      <span class="w-5 h-5 rounded-md bg-[#003CA5]/10 dark:bg-white/5 text-[#003CA5] dark:text-[#5B8EFF] flex items-center justify-center text-[10px] font-bold shrink-0">
                        <% case skill[:icon] %>
                        <% when "figma" %>
                          ❖
                        <% when "system" %>
                          ◫
                        <% when "adobe" %>
                          ▲
                        <% when "prototype" %>
                          ◈
                        <% when "tailwind" %>
                          ≈
                        <% when "js" %>
                          JS
                        <% when "rails" %>
                          ♦
                        <% when "react" %>
                          ⚛
                        <% when "brain" %>
                          🧠
                        <% when "wcag" %>
                          ♿
                        <% when "security" %>
                          🛡
                        <% when "python" %>
                          🐍
                        <% else %>
                          ✦
                        <% end %>
                      </span>
                      <span class="font-semibold text-brand-tinta dark:text-white"><%= skill[:name] %></span>
                    </div>

                    <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 shrink-0 font-medium">
                      <%= skill[:years] %> <%= t('skills.years', default: 'anos') %>
                    </span>
                  </div>

                  <!-- Visual Evolution / Mastery Bar -->
                  <div class="w-full bg-brand-tinta/5 dark:bg-white/5 rounded-full h-1.5 overflow-hidden">
                    <div class="bg-gradient-to-r from-[#003CA5] to-[#00A5FF] h-full rounded-full transition-all duration-1000" style="width: <%= skill[:percent] %>%;"></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>
