<%
  categories = [
    {
      title: "Design de Produto & Sistemas",
      skills: [
        { name: "Figma & Design Tokens", years: "10 anos" },
        { name: "Design Systems (0 → 1)", years: "12 anos" },
        { name: "Adobe Creative Cloud", years: "18 anos" },
        { name: "Prototipagem & Microinterações", years: "10 anos" }
      ]
    },
    {
      title: "Engenharia Front-End & Código",
      skills: [
        { name: "Tailwind CSS & Design Tokens", years: "6 anos" },
        { name: "TypeScript & JavaScript", years: "12 anos" },
        { name: "Ruby on Rails & Hotwire", years: "8 anos" },
        { name: "React & Next.js", years: "7 anos" }
      ]
    },
    {
      title: "Ciência Comportamental & Segurança",
      skills: [
        { name: "Psicologia Cognitiva & IHC", years: "8 anos" },
        { name: "WCAG & Acessibilidade AAA", years: "10 anos" },
        { name: "Linux & JS Security (Linux Foundation)", years: "6 anos" },
        { name: "Python & Automação de Dados", years: "5 anos" }
      ]
    }
  ]
%>

<!-- Software Stack & Tools (Clean, Static & Elegant Presentation) -->
<section class="py-16 md:py-24 bg-brand-surface dark:bg-[#0B0D10] w-full border-t border-brand-tinta/5 dark:border-white/5" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12" data-reveal-target="item">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold mb-2">
        <span>✦</span>
        <span>Ferramentas &amp; Stack</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight">
        Ferramentas do Ofício &amp; Experiência
      </h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">
        Ferramentas e tecnologias dominadas ao longo de duas décadas de prática contínua.
      </p>
    </div>

    <!-- 3-Column Categorized Stack Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      <% categories.each do |cat| %>
        <div class="p-6 rounded-2xl bg-brand-fundo dark:bg-[#13171F] border border-brand-tinta/5 dark:border-white/5 flex flex-col justify-between" data-reveal-target="item">
          <div>
            <h3 class="text-sm font-bold font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-wider mb-4 pb-2 border-b border-brand-tinta/5 dark:border-white/5">
              <%= cat[:title] %>
            </h3>

            <div class="space-y-3">
              <% cat[:skills].each do |skill| %>
                <div class="flex items-center justify-between py-1 text-xs">
                  <span class="font-medium text-brand-tinta dark:text-white"><%= skill[:name] %></span>
                  <span class="font-mono text-[11px] text-neutral-500 shrink-0 ml-2"><%= skill[:years] %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>
