<%
  categories = [
    {
      title_key: "skills.cat_design",
      default_title: "Design de Produto & Sistemas",
      icon: "❖",
      color: "text-[#003CA5] dark:text-[#5B8EFF]",
      bg: "bg-[#003CA5]/10",
      skills: [
        { name_key: "skills.skill_figma", default_name: "Figma & Design Tokens", years: 10, logo_type: "figma" },
        { name_key: "skills.skill_system", default_name: "Design Systems & Storybook", years: 12, logo_type: "system" },
        { name_key: "skills.skill_adobe", default_name: "Adobe Creative Cloud", years: 18, logo_type: "adobe" },
        { name_key: "skills.skill_framer", default_name: "Prototipagem & Framer", years: 10, logo_type: "framer" }
      ]
    },
    {
      title_key: "skills.cat_eng",
      default_title: "Engenharia Front-End & Código",
      icon: "⚡",
      color: "text-sky-600 dark:text-sky-400",
      bg: "bg-sky-500/10",
      skills: [
        { name_key: "skills.skill_tailwind", default_name: "Tailwind CSS & Tokens", years: 6, logo_type: "tailwind" },
        { name_key: "skills.skill_typescript", default_name: "TypeScript & JavaScript", years: 12, logo_type: "typescript" },
        { name_key: "skills.skill_rails", default_name: "Ruby on Rails & Hotwire", years: 8, logo_type: "rails" },
        { name_key: "skills.skill_react", default_name: "React & Next.js", years: 7, logo_type: "react" }
      ]
    },
    {
      title_key: "skills.cat_science",
      default_title: "Ciência Comportamental & Segurança",
      icon: "🧠",
      color: "text-purple-600 dark:text-purple-400",
      bg: "bg-purple-500/10",
      skills: [
        { name_key: "skills.skill_psychology", default_name: "Psicologia Cognitiva & IHC", years: 8, logo_type: "psychology" },
        { name_key: "skills.skill_wcag", default_name: "WCAG & Acessibilidade AAA", years: 10, logo_type: "wcag" },
        { name_key: "skills.skill_linux", default_name: "The Linux Foundation & Security", years: 6, logo_type: "linux_foundation" },
        { name_key: "skills.skill_python", default_name: "Python & Automação de Dados", years: 5, logo_type: "python" }
      ]
    }
  ]
%>

<!-- Software Stack & Tools (With Official Brand Logos & Optimized Experience Pills) -->
<section class="py-16 md:py-24 bg-brand-surface dark:bg-[#0B0D10] w-full border-t border-brand-tinta/5 dark:border-white/5" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12" data-reveal-target="item">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold mb-2">
        <span>✦</span>
        <span><%= t('skills.eyebrow', default: 'Ferramentas & Stack') %></span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight">
        <%= t('skills.title', default: 'Ferramentas do Ofício & Especialização') %>
      </h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">
        <%= t('skills.subtitle', default: 'Competências técnicas consolidadas e aplicadas em escala ao longo de duas décadas.') %>
      </p>
    </div>

    <!-- 3-Column Categorized Stack Grid with Official Logos -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      <% categories.each do |cat| %>
        <div class="p-6 sm:p-7 rounded-3xl bg-brand-fundo dark:bg-[#13171F] border border-brand-tinta/10 dark:border-white/10 flex flex-col justify-between shadow-sm card-border-glow hover:border-[#003CA5]/30 dark:hover:border-[#5B8EFF]/30 transition-all" data-reveal-target="item">
          <div>
            <!-- Category Header -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-brand-tinta/10 dark:border-white/10">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-6 h-6 rounded-lg <%= cat[:bg] %> <%= cat[:color] %> flex items-center justify-center text-xs font-bold shrink-0">
                  <%= cat[:icon] %>
                </span>
                <h3 class="text-xs font-bold font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-wider truncate">
                  <%= t(cat[:title_key], default: cat[:default_title]) %>
                </h3>
              </div>
              <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500 uppercase tracking-widest shrink-0 ml-2">
                <%= t('skills.mastery', default: 'Experiência') %>
              </span>
            </div>

            <!-- Skills List -->
            <div class="space-y-2.5">
              <% cat[:skills].each do |skill| %>
                <div class="group flex items-center justify-between p-2.5 sm:p-3 rounded-2xl bg-brand-surface dark:bg-white/[0.03] hover:bg-white dark:hover:bg-white/[0.08] border border-brand-tinta/5 dark:border-white/5 hover:border-[#003CA5]/30 dark:hover:border-[#5B8EFF]/40 hover:shadow-md transition-all duration-200">
                  
                  <!-- Left: Icon + Name -->
                  <div class="flex items-center gap-3 min-w-0 pr-2">
                    <!-- Official Logo Container -->
                    <div class="w-8 h-8 rounded-xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/10 dark:border-white/10 flex items-center justify-center shrink-0 p-1.5 shadow-xs group-hover:scale-105 group-hover:border-[#003CA5]/40 dark:group-hover:border-[#5B8EFF]/40 transition-all">
                      <% case skill[:logo_type] %>
                      <% when "figma" %>
                        <svg class="w-full h-full" viewBox="0 0 38 57" fill="none">
                          <path d="M19 28.5C19 23.2533 23.2533 19 28.5 19C33.7467 19 38 23.2533 38 28.5C38 33.7467 33.7467 38 28.5 38C23.2533 38 19 33.7467 19 28.5Z" fill="#1ABCFE"/>
                          <path d="M0 47.5C0 42.2533 4.25329 38 9.5 38H19V47.5C19 52.7467 14.7467 57 9.5 57C4.25329 57 0 52.7467 0 47.5Z" fill="#0ACF83"/>
                          <path d="M19 0V19H28.5C33.7467 19 38 14.7467 38 9.5C38 4.25329 33.7467 0 28.5 0H19Z" fill="#FF7262"/>
                          <path d="M0 9.5C0 14.7467 4.25329 19 9.5 19H19V0H9.5C4.25329 0 0 4.25329 0 9.5Z" fill="#F24E1E"/>
                          <path d="M0 28.5C0 33.7467 4.25329 38 9.5 38H19V19H9.5C4.25329 19 0 23.2533 0 28.5Z" fill="#A259FF"/>
                        </svg>
                      <% when "system" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <path d="M2.5 3.5C2.5 2.67157 3.17157 2 4 2H19.5C20.3284 2 21 2.67157 21 3.5V20.5C21 21.3284 20.3284 22 19.5 22H4C3.17157 22 2.5 21.3284 2.5 20.5V3.5Z" fill="#FF4785"/>
                          <path d="M15.4 6.7L14.7 8.3C14.7 8.3 14 7.9 13.1 7.9C11.9 7.9 11.5 8.4 11.5 8.9C11.5 10.4 16 9.8 16 13.1C16 15.3 14.1 16.5 11.8 16.5C9.8 16.5 8.7 15.8 8.7 15.8L9.4 14.1C9.4 14.1 10.4 14.8 11.7 14.8C12.8 14.8 13.4 14.3 13.4 13.6C13.4 12.1 9 12.5 9 9.3C9 7.4 10.7 6.2 13 6.2C14.5 6.2 15.4 6.7 15.4 6.7Z" fill="white"/>
                        </svg>
                      <% when "adobe" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="#DA1F26">
                          <path d="M14.567 0H24v24H14.567V0zm-5.134 0H0v24h9.433V0zm2.567 10.297L13.9 16.7h-3.8l-1.9-4.87-2.933 7.47H2.867l6.6-16.7h3.833l3.833 9.697h-2.133l-3.001-7.001z"/>
                        </svg>
                      <% when "framer" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <path d="M4 0h16v8h-8zM4 8h8l8 8H4zM4 16h8v8z" fill="#0055FF"/>
                        </svg>
                      <% when "tailwind" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="#38BDF8">
                          <path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"/>
                        </svg>
                      <% when "typescript" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <rect width="24" height="24" rx="4" fill="#3178C6"/>
                          <path d="M11.75 14.25c-.25.75-.75 1.25-1.5 1.5s-1.5.25-2.25 0c-.75-.25-1.25-.75-1.5-1.5l1.5-.75c.15.5.4.75.75.9.35.15.75.15 1.1 0 .35-.15.5-.4.5-.75 0-.3-.1-.5-.3-.65s-.5-.3-.9-.45l-.75-.3c-.6-.25-1.1-.55-1.4-.9-.3-.35-.5-.85-.5-1.45 0-.75.3-1.35.85-1.8.55-.45 1.3-.7 2.25-.7.8 0 1.5.2 2.05.55.55.35.9.85 1.05 1.5l-1.5.6c-.1-.35-.3-.6-.6-.75s-.65-.25-1.05-.25c-.4 0-.75.1-1 .25-.25.15-.4.4-.4.65 0 .25.1.45.3.6s.5.3.9.45l.75.3c.7.25 1.2.55 1.5.9.3.35.45.85.45 1.5zM17.5 8h-4.5v1.5h1.5v6.5h1.5v-6.5h1.5V8z" fill="white"/>
                        </svg>
                      <% when "rails" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M19.78 2.01c2.33 1.35 4.22 4.63 4.22 7.32 0 2.7-1.89 5.97-4.22 7.32l-6.34 3.66c-2.33 1.35-6.11 1.35-8.44 0l-1.22-.7c-.78-.45-1.22-1.21-1.22-2.11V6.5c0-.9.44-1.66 1.22-2.11l1.22-.7c2.33-1.35 6.11-1.35 8.44 0l6.34 3.66c.78.45 1.22 1.21 1.22 2.11v2.85c0 .9-.44 1.66-1.22 2.11l-3.8 2.2c-.78.45-2.04.45-2.82 0l-1.22-.7c-.78-.45-1.22-1.21-1.22-2.11v-2.85c0-.9.44-1.66 1.22-2.11l1.22-.7c.78-.45 2.04-.45 2.82 0l3.8 2.2V2.01z" fill="#CC0000"/>
                        </svg>
                      <% when "react" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <ellipse cx="12" cy="12" rx="10" ry="4.5" stroke="#61DAFB" stroke-width="1.5" transform="rotate(0 12 12)"/>
                          <ellipse cx="12" cy="12" rx="10" ry="4.5" stroke="#61DAFB" stroke-width="1.5" transform="rotate(60 12 12)"/>
                          <ellipse cx="12" cy="12" rx="10" ry="4.5" stroke="#61DAFB" stroke-width="1.5" transform="rotate(120 12 12)"/>
                          <circle cx="12" cy="12" r="1.8" fill="#61DAFB"/>
                        </svg>
                      <% when "psychology" %>
                        <svg class="w-full h-full text-[#8B5CF6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 2v20"/>
                          <path d="M6 4v5a6 6 0 0 0 12 0V4"/>
                          <path d="M9 22h6"/>
                        </svg>
                      <% when "wcag" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <circle cx="12" cy="12" r="11" fill="#005A9C"/>
                          <circle cx="12" cy="6" r="1.8" fill="white"/>
                          <path d="M5.5 9.5l6.5 1.5 6.5-1.5M12 11v5l-3 4.5M12 16l3 4.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      <% when "linux_foundation" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <path d="M3 3h8v8H3V3z" fill="#003449"/>
                          <path d="M13 3h8v8h-8V3z" fill="#87C042"/>
                          <path d="M3 13h8v8H3v-8z" fill="#00A2DE"/>
                          <path d="M13 13h8v8h-8v-8z" fill="#003449"/>
                        </svg>
                      <% when "python" %>
                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
                          <path d="M11.914 0C5.82 0 6.2 2.644 6.2 2.644l.006 2.738h5.816v.826H3.906S0 5.762 0 11.874c0 6.112 3.407 5.918 3.407 5.918h2.036v-2.856s-.11-3.407 3.35-3.407h5.76v-.884h.054V5.733s.51-5.733-6.22-5.733zm-3.32 1.808c.594 0 1.077.483 1.077 1.077 0 .595-.483 1.077-1.077 1.077-.595 0-1.077-.482-1.077-1.077 0-.594.482-1.077 1.077-1.077z" fill="#3776AB"/>
                          <path d="M12.086 24c6.094 0 5.714-2.644 5.714-2.644l-.006-2.738h-5.816v-.826h8.116s3.906.446 3.906-5.666c0-6.112-3.407-5.918-3.407-5.918h-2.036v2.856s.11 3.407-3.35 3.407h-5.76v.884h-.054v4.915s-.51 5.733 6.22 5.733zm3.32-1.808c-.594 0-1.077-.483-1.077-1.077 0-.595.483-1.077 1.077-1.077.595 0 1.077.482 1.077 1.077 0 .594-.482 1.077-1.077 1.077z" fill="#FFD438"/>
                        </svg>
                      <% end %>
                    </div>

                    <span class="text-xs font-bold text-brand-tinta dark:text-white group-hover:text-[#003CA5] dark:group-hover:text-[#5B8EFF] transition-colors truncate">
                      <%= t(skill[:name_key], default: skill[:default_name]) %>
                    </span>
                  </div>

                  <!-- Right: High-Precision Experience Metric Pill -->
                  <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-[#003CA5]/5 dark:bg-[#5B8EFF]/10 text-[#003CA5] dark:text-[#5B8EFF] border border-[#003CA5]/15 dark:border-[#5B8EFF]/25 shrink-0 group-hover:bg-[#003CA5] group-hover:text-white dark:group-hover:bg-[#5B8EFF] dark:group-hover:text-[#0B0D10] group-hover:border-transparent transition-all duration-200 shadow-2xs">
                    <span class="tracking-tight"><%= skill[:years] %>+</span>
                    <span class="text-[10px] font-sans font-medium uppercase tracking-wider opacity-75 group-hover:opacity-100">
                      <%= t('skills.years', default: 'anos') %>
                    </span>
                  </div>

                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>
