<%
  nav_links = [
    { href: '#work', label: t('nav.work', default: 'Portfólio') },
    { href: '#pillars', label: t('nav.bento', default: 'Pilares') },
    { href: '#cv', label: t('nav.cv', default: 'Experiência') },
    { href: '#about', label: t('nav.about', default: 'Sobre') }
  ]
%>

<!-- Mobile Header Bar -->
<div data-controller="mobile-menu" class="md:hidden">
  <header id="mobile-navbar" data-controller="navbar" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 bg-brand-fundo/80 dark:bg-brand-dark-fundo/80 backdrop-blur-md py-3 border-b border-brand-tinta/5 dark:border-white/5">
    <div class="max-w-6xl mx-auto px-4 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center group focus:outline-none focus:ring-2 focus:ring-brand-primaria rounded-lg p-1">
        <%= render 'shared/logo', custom_class: 'h-7 w-auto text-[#003CA5] dark:text-white antialiased' %>
      </a>

      <!-- Right Actions -->
      <div class="flex items-center gap-2">
        <!-- Mobile Header CV Button -->
        <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>" target="_blank" data-turbo="false" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-mono font-bold bg-[#003CA5] text-white hover:bg-[#002361] shadow-sm transition-all border border-[#003CA5]/20" title="<%= I18n.locale.to_s.start_with?('pt') ? 'Descarregar CV' : (I18n.locale.to_s.start_with?('es') ? 'Descargar CV' : 'Download CV') %>">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          <span>CV</span>
        </a>

        <!-- Theme Switcher -->
        <div data-controller="theme">
          <button data-action="click->theme#toggle" class="p-2 rounded-full text-brand-tinta dark:text-brand-dark-tinta hover:bg-brand-tinta/10 dark:hover:bg-brand-dark-tinta/10 transition-all" title="Toggle Theme">
            <svg data-theme-target="iconDark" class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            <svg data-theme-target="iconLight" class="w-5 h-5 pointer-events-none hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          </button>
        </div>

        <!-- Hamburger Button -->
        <button data-action="click->mobile-menu#toggle" data-mobile-menu-target="hamburger" class="p-2 rounded-full text-brand-tinta dark:text-brand-dark-tinta hover:bg-brand-tinta/10 dark:hover:bg-brand-dark-tinta/10 transition-all" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Backdrop -->
  <div data-mobile-menu-target="backdrop" data-action="click->mobile-menu#close" class="fixed inset-0 z-[998] bg-black/60 backdrop-blur-sm transition-opacity duration-300 hidden opacity-0"></div>

  <!-- Mobile Drawer Panel -->
  <nav data-mobile-menu-target="drawer" class="fixed top-0 right-0 z-[999] h-full w-72 bg-white dark:bg-[#0B0D10] border-l border-neutral-200 dark:border-white/10 shadow-2xl transform translate-x-full transition-transform duration-300 ease-out flex flex-col">
    
    <!-- Drawer Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-100 dark:border-white/5">
      <%= render 'shared/logo', custom_class: 'h-6 w-auto text-[#003CA5] dark:text-white antialiased' %>
      <button data-action="click->mobile-menu#close" data-mobile-menu-target="closeBtn" class="p-2 rounded-full text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/10 transition-all" aria-label="Fechar menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <div class="flex-1 overflow-y-auto px-4 py-6 space-y-1">
      <% nav_links.each do |link| %>
        <a href="<%= link[:href] %>" data-action="click->mobile-menu#navigate" class="block px-4 py-3.5 rounded-xl text-[15px] font-semibold text-neutral-800 dark:text-neutral-100 hover:text-[#003CA5] dark:hover:text-[#003CA5] hover:bg-neutral-50 dark:hover:bg-white/5 transition-all">
          <%= link[:label] %>
        </a>
      <% end %>
      <a href="#contact" data-action="click->mobile-menu#navigate" class="block px-4 py-3.5 rounded-xl text-[15px] font-semibold text-neutral-800 dark:text-neutral-100 hover:text-[#003CA5] dark:hover:text-[#003CA5] hover:bg-neutral-50 dark:hover:bg-white/5 transition-all">
        <%= t('nav.contact', default: 'Contact') %>
      </a>
    </div>

    <!-- Drawer Footer -->
    <div class="px-5 py-5 border-t border-neutral-100 dark:border-white/5 space-y-4">
      <!-- Language Switcher -->
      <div class="flex items-center bg-neutral-50 dark:bg-white/5 p-1 rounded-full border border-neutral-200 dark:border-white/10 text-xs font-mono shadow-sm">
        <a href="?locale=en" data-turbo="false" class="flex-1 flex items-center justify-center gap-1 px-2 py-1.5 rounded-full uppercase transition-all font-semibold <%= I18n.locale == :en || I18n.locale.nil? ? 'bg-[#003CA5] text-white shadow-sm' : 'text-neutral-500 dark:text-neutral-400' %>" title="English">
          <span>🇬🇧</span> EN
        </a>
        <a href="?locale=es" data-turbo="false" class="flex-1 flex items-center justify-center gap-1 px-2 py-1.5 rounded-full uppercase transition-all font-semibold <%= I18n.locale == :es ? 'bg-[#003CA5] text-white shadow-sm' : 'text-neutral-500 dark:text-neutral-400' %>" title="Español">
          <span>🇪🇸</span> ES
        </a>
        <a href="?locale=pt-PT" data-turbo="false" class="flex-1 flex items-center justify-center gap-1 px-2 py-1.5 rounded-full uppercase transition-all font-semibold <%= I18n.locale == :'pt-PT' ? 'bg-[#003CA5] text-white shadow-sm' : 'text-neutral-500 dark:text-neutral-400' %>" title="Português (Portugal)">
          <span>🇵🇹</span> PT
        </a>
      </div>

      <!-- CV Download Button -->
      <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>" target="_blank" data-turbo="false" class="group flex items-center justify-center gap-2 w-full px-5 py-3 rounded-full text-xs font-mono font-bold bg-[#003CA5] text-white shadow-lg shadow-[#003CA5]/20 hover:shadow-[#003CA5]/40 transition-all">
        <span><%= I18n.locale.to_s.start_with?('pt') ? 'Baixar CV' : (I18n.locale.to_s.start_with?('es') ? 'Descargar CV' : 'Download CV') %></span>
        <svg class="w-3.5 h-3.5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
      </a>
    </div>
  </nav>
</div>

<!-- Desktop Header Top Bar -->
<header id="desktop-navbar" data-controller="navbar" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 hidden md:block bg-brand-fundo/80 dark:bg-brand-dark-fundo/80 backdrop-blur-md py-4 border-b border-brand-tinta/5 dark:border-white/5">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between">
    <!-- Logo & Domain -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-primaria rounded-lg p-1">
      <div class="transition-all group-hover:scale-105">
        <%= render 'shared/logo', custom_class: 'h-8 sm:h-9 w-auto text-[#003CA5] dark:text-white antialiased' %>
      </div>
    </a>

    <!-- Desktop Links -->
    <nav class="flex items-center gap-6">
      <% nav_links.each do |link| %>
        <a href="<%= link[:href] %>" class="text-sm font-medium text-brand-tinta/70 dark:text-brand-dark-tinta/70 hover:text-brand-primaria dark:hover:text-brand-dark-primaria transition-colors">
          <%= link[:label] %>
        </a>
      <% end %>
    </nav>

    <!-- Right Actions: Lang Selector & Europass Modal -->
    <div class="flex items-center gap-4">
      <!-- Theme Switcher -->
      <div data-controller="theme" class="flex items-center bg-brand-surface dark:bg-brand-dark-surface p-1 rounded-full border border-brand-tinta/10 dark:border-white/10 text-xs font-mono shadow-sm">
        <button data-action="click->theme#toggle" class="p-1.5 rounded-full transition-all text-brand-tinta dark:text-brand-dark-tinta hover:bg-brand-tinta/10 dark:hover:bg-brand-dark-tinta/10" title="Toggle Theme">
          <!-- Moon Icon (Switch to Dark) -->
          <svg data-theme-target="iconDark" class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <!-- Sun Icon (Switch to Light) -->
          <svg data-theme-target="iconLight" class="w-4 h-4 pointer-events-none hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
      </div>

      <!-- Language Switcher -->
      <div class="flex items-center bg-brand-surface dark:bg-brand-dark-surface p-1 rounded-full border border-brand-tinta/10 dark:border-white/10 text-xs font-mono shadow-sm">
        <a href="?locale=en" data-turbo="false" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full uppercase transition-all font-semibold <%= I18n.locale == :en || I18n.locale.nil? ? 'bg-brand-tinta dark:bg-brand-dark-tinta text-brand-surface dark:text-brand-dark-fundo' : 'text-brand-tinta/60 dark:text-brand-dark-tinta/60 hover:text-brand-tinta dark:hover:text-brand-dark-tinta' %>" title="English">
          <span>🇬🇧</span> EN
        </a>
        <a href="?locale=es" data-turbo="false" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full uppercase transition-all font-semibold <%= I18n.locale == :es ? 'bg-brand-tinta dark:bg-brand-dark-tinta text-brand-surface dark:text-brand-dark-fundo' : 'text-brand-tinta/60 dark:text-brand-dark-tinta/60 hover:text-brand-tinta dark:hover:text-brand-dark-tinta' %>" title="Español">
          <span>🇪🇸</span> ES
        </a>
        <a href="?locale=pt-PT" data-turbo="false" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full uppercase transition-all font-semibold <%= I18n.locale == :'pt-PT' ? 'bg-brand-tinta dark:bg-brand-dark-tinta text-brand-surface dark:text-brand-dark-fundo' : 'text-brand-tinta/60 dark:text-brand-dark-tinta/60 hover:text-brand-tinta dark:hover:text-brand-dark-tinta' %>" title="Português (Portugal)">
          <span>🇵🇹</span> PT
        </a>
      </div>

      <!-- CV Button -->
      <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>" target="_blank" data-turbo="false" class="group flex items-center gap-2 px-5 py-2 rounded-full text-xs font-mono font-bold bg-gradient-to-r from-[#003CA5] to-brand-primaria text-white shadow-lg shadow-brand-primaria/20 hover:shadow-brand-primaria/40 hover:-translate-y-0.5 transition-all border border-white/10">
        <span><%= I18n.locale.to_s.start_with?('pt') ? 'Baixar CV' : (I18n.locale.to_s.start_with?('es') ? 'Descargar CV' : 'Download CV') %></span>
        <svg class="w-3.5 h-3.5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
      </a>
    </div>
  </div>
</header>

