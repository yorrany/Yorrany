<!-- Hero Section -->
<section class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-brand-fundo dark:bg-brand-dark-fundo w-full bg-grid-suico">
  <div class="max-w-6xl mx-auto px-6 sm:px-8">
    
    <!-- Language Switcher could be in navbar, but we ensure it's available -->
    
    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-brand-titulos dark:text-brand-dark-tinta leading-[1.1] max-w-4xl mb-8">
      <%= t('hero.h1') %>
    </h1>

    <!-- Subheadline -->
    <p class="text-xl sm:text-2xl text-brand-tinta/80 dark:text-brand-dark-tinta/80 max-w-3xl font-normal leading-relaxed mb-12">
      <%= raw t('hero.sub').gsub(/mente humana/, '<span class="marker-highlight">mente humana</span>').gsub(/human mind/, '<span class="marker-highlight">human mind</span>').gsub(/mente humana/, '<span class="marker-highlight">mente humana</span>') %>
    </p>

    <!-- Primary Action Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-6">
      <a href="#work" class="flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-brand-primaria dark:bg-brand-dark-primaria text-white font-medium text-lg transition-transform hover:-translate-y-1 hover:shadow-2xl shadow-brand-primaria/30">
        <span><%= t('hero.cta_primary', default: 'View My Work') %></span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>

      <a href="#europe" class="group relative flex items-center justify-center gap-3 px-8 py-4 rounded-full overflow-hidden bg-brand-surface dark:bg-[#13171F] border border-brand-tinta/10 dark:border-white/10 hover:border-[#003CA5]/50 hover:shadow-lg hover:shadow-[#003CA5]/10 text-brand-tinta dark:text-white font-medium text-lg transition-all duration-300 hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-r from-[#003CA5]/0 via-[#003CA5]/5 to-[#003CA5]/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <svg class="w-5 h-5 text-[#003CA5] relative z-10 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="relative z-10"><%= t('hero.cta_secondary') %></span>
      </a>
    </div>

  </div>
</section>
