<%
  featured_project = @case_studies.find(&:is_spotlight) || @case_studies.first
%>

<!-- Hero Section (Clean, Elegant & High-Impact) -->
<section class="relative min-h-[88vh] flex flex-col justify-center pt-28 pb-16 lg:pt-36 lg:pb-24 overflow-hidden bg-brand-fundo dark:bg-brand-dark-fundo w-full bg-grid-suico" data-controller="reveal">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-12 right-1/4 w-96 h-96 bg-[#003CA5]/10 dark:bg-[#003CA5]/20 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-12 left-12 w-80 h-80 bg-[#00A5FF]/10 dark:bg-[#00A5FF]/15 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center">
      
      <!-- Left Column: Editorial & Value Proposition (7 Cols on LG) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left" data-reveal-target="item">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-brand-surface dark:bg-white/5 border border-brand-tinta/10 dark:border-white/10 shadow-sm mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300">
            <%= t('hero.available_pill', default: (I18n.locale.to_s.start_with?('pt') ? 'Disponível para Projetos & Posições Globais (EU / Remoto)' : (I18n.locale.to_s.start_with?('es') ? 'Disponible para Proyectos Globales (EU / Remoto)' : 'Available for Global Roles (EU / Remote)'))) %>
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-[62px] font-extrabold tracking-tight text-brand-titulos dark:text-white leading-[1.08] mb-6">
          <%= t('hero.h1') %>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-brand-tinta/80 dark:text-neutral-300 font-normal leading-relaxed mb-8 max-w-2xl">
          <%= raw t('hero.sub').gsub(/mente humana/, '<span class="marker-highlight font-semibold text-brand-titulos dark:text-white">mente humana</span>').gsub(/human mind/, '<span class="marker-highlight font-semibold text-brand-titulos dark:text-white">human mind</span>') %>
        </p>

        <!-- Primary Actions -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a href="#work" class="group relative flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-[#003CA5] hover:bg-[#002361] overflow-hidden hover:-translate-y-0.5 hover:shadow-xl hover:shadow-[#003CA5]/25 transition-all duration-300 text-white font-mono font-bold text-sm">
            <span class="relative z-10"><%= t('hero.cta_primary', default: 'Ver Portfólio') %></span>
            <svg class="w-4 h-4 text-white relative z-10 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>

          <a href="#contact" class="flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-brand-surface dark:bg-[#13171F] border border-brand-tinta/10 dark:border-white/10 hover:border-[#003CA5]/50 dark:hover:border-[#5B8EFF]/50 text-brand-tinta dark:text-white font-mono font-bold text-sm transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5">
            <span><%= t('contact.title', default: 'Entrar em Contato') %></span>
          </a>

          <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>" target="_blank" data-turbo="false" class="inline-flex items-center gap-2 px-4 py-4 rounded-full text-xs font-mono text-neutral-600 dark:text-neutral-400 hover:text-brand-titulos dark:hover:text-white transition-colors">
            <svg class="w-4 h-4 text-[#003CA5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span>CV (PDF)</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Authentic Spotlight Showcase (5 Cols on LG) -->
      <div class="lg:col-span-5 w-full" data-reveal-target="item">
        <% if featured_project && featured_project.image.attached? %>
          <div data-controller="tilt" data-action="click->modal#openCase" data-id="<%= featured_project.id %>" class="group relative rounded-3xl overflow-hidden bg-neutral-900 border border-brand-tinta/10 dark:border-white/10 shadow-2xl cursor-pointer hover:border-[#003CA5]/50 transition-all duration-500 card-border-glow">
            
            <!-- Real Case Showcase Image -->
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-neutral-950">
              <%= image_tag featured_project.image, alt: featured_project.title, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none", loading: "eager" %>
              
              <!-- Subtle Vignette & Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              
              <!-- Spotlight Badge -->
              <div class="absolute top-4 left-4 z-10">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/75 backdrop-blur-md text-white border border-white/15 text-[11px] font-mono font-semibold">
                  <span class="text-[#5B8EFF]">✦</span> <%= t('work.spotlightBadge', default: 'Projeto em Destaque') %>
                </span>
              </div>

              <!-- Project Caption on Image -->
              <div class="absolute bottom-4 inset-x-4 z-10 flex items-end justify-between gap-4 text-white">
                <div>
                  <h3 class="text-xl font-bold font-sans leading-snug"><%= featured_project.title %></h3>
                  <p class="text-xs text-neutral-300 font-mono mt-0.5"><%= featured_project.role.presence || "Product Design & Strategy" %></p>
                </div>

                <span class="w-9 h-9 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center shrink-0 group-hover:bg-[#003CA5] group-hover:scale-110 transition-all">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </span>
              </div>
            </div>

          </div>
        <% end %>
      </div>

    </div>
  </div>
</section>
