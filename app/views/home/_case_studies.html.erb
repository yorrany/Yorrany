<!-- Case Studies Section -->
<section id="work" class="py-20 md:py-28 bg-[#F5F8FF] dark:bg-[#0A101C] border-y border-[#003CA5]/10 w-full" data-controller="portfolio-filter">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Title Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center gap-2 text-xs font-mono text-[#003CA5] uppercase tracking-widest mb-3">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        <span><%= t('work.eyebrow', default: 'Selected Portfolio') %></span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight">
        <%= t('work.title', default: 'Case Studies') %>
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base max-w-xl mx-auto mt-2">
        <%= t('work.subtitle', default: 'A selection of products where design strategy and behavioral insights drove measurable business impact.') %>
      </p>
    </div>

    <!-- Centered Filter Chips -->
    <div class="flex flex-wrap justify-center items-center gap-2 mb-14 font-mono text-xs">
      <% [t('work.filters.all', default: 'Todos'), t('work.filters.pd', default: 'Product Design'), 'UX/UI', t('work.filters.brand', default: 'Estratégia de Marca'), 'E-Commerce'].each do |filter| %>
        <button 
          data-action="click->portfolio-filter#filter"
          data-portfolio-filter-target="button"
          data-filter="<%= filter %>"
          class="px-5 py-2.5 rounded-full whitespace-nowrap transition-all border <%= filter == t('work.filters.all', default: 'Todos') ? 'bg-[#003CA5] text-white border-[#003CA5] font-bold shadow-md' : 'bg-brand-surface dark:bg-[#13171F] text-brand-tinta/70 dark:text-neutral-400 border-brand-tinta/10 dark:border-white/10 hover:bg-brand-tinta hover:text-brand-surface dark:hover:bg-white/10 dark:hover:text-white' %>">
          <%= filter %>
        </button>
      <% end %>
    </div>

    <% spotlight_project = @case_studies.find(&:is_spotlight) || @case_studies.first %>
    <% if spotlight_project %>
      <!-- 1. SPOTLIGHT CASE STUDY -->
      <div data-portfolio-filter-target="item" data-tags="<%= spotlight_project.tags %> <%= spotlight_project.role %>" class="mb-14 transition-all duration-500">
        <div data-action="click->modal#openCase" data-id="<%= spotlight_project.id %>" class="bg-brand-surface dark:bg-[#13171F] rounded-3xl border border-[#003CA5]/30 hover:border-[#003CA5]/60 overflow-hidden shadow-2xl relative group cursor-pointer transition-all duration-300">
          <div class="flex flex-col lg:flex-row items-stretch min-h-[420px]">
            
            <!-- Coluna de Conteúdo (Lado Esquerdo no Desktop) -->
            <div class="w-full lg:w-7/12 p-7 sm:p-10 lg:p-12 flex flex-col justify-between z-10 bg-brand-surface dark:bg-[#13171F]">
              <div>
                <!-- Spotlight Badge & Período -->
                <div class="flex flex-wrap items-center gap-3 mb-5">
                  <span class="px-3 py-1 rounded-full bg-[#003CA5]/15 border border-[#003CA5]/40 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] font-bold flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                    <%= t('work.spotlightBadge', default: 'Featured Spotlight') %>
                  </span>
                  <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
                    <%= spotlight_project.period %>
                  </span>
                  <% if spotlight_project.role.present? %>
                    <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 bg-brand-fundo dark:bg-[#0B0D10] px-2.5 py-0.5 rounded-full border border-brand-tinta/5 dark:border-white/10">
                      <%= spotlight_project.role %>
                    </span>
                  <% end %>
                </div>

                <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight mb-3 group-hover:text-[#003CA5] dark:group-hover:text-[#5B8EFF] transition-colors">
                  <%= spotlight_project.title %>
                </h3>

                <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 font-medium mb-4">
                  <%= spotlight_project.tagline %>
                </p>

                <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6 line-clamp-3">
                  <%= spotlight_project.summary %>
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2 mb-6">
                  <% (spotlight_project.tags || "").split(',').first(5).each do |tag| %>
                    <span class="px-2.5 py-1 rounded-lg bg-brand-fundo dark:bg-[#0B0D10] text-[11px] font-mono text-neutral-700 dark:text-neutral-300 border border-brand-tinta/5 dark:border-white/10">
                      <%= tag.strip %>
                    </span>
                  <% end %>
                </div>
              </div>

              <!-- CTA & Cliente -->
              <div class="pt-6 border-t border-brand-tinta/5 dark:border-white/10 flex items-center justify-between">
                <span class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] font-bold group-hover:translate-x-1 transition-transform">
                  <%= t('work.viewCase', default: 'Read Case Study') %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
                <span class="text-xs font-mono text-neutral-500">
                  <%= spotlight_project.client %>
                </span>
              </div>
            </div>

            <!-- Coluna da Imagem em Destaque (Lado Direito no Desktop) -->
            <div class="w-full lg:w-5/12 min-h-[280px] sm:min-h-[360px] lg:min-h-[420px] relative overflow-hidden bg-neutral-100 dark:bg-[#07090E] border-t lg:border-t-0 lg:border-l border-neutral-200/60 dark:border-white/10">
              <% if spotlight_project.image.attached? %>
                <%= image_tag spotlight_project.image, class: "absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 pointer-events-none", loading: "eager" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-neutral-600 text-sm font-mono">Sem Imagem</div>
              <% end %>
            </div>

          </div>
        </div>
      </div>

      <!-- 2. SECONDARY PROJECTS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% @case_studies.reject { |cs| cs.id == spotlight_project.id }.each do |project| %>
          <div data-portfolio-filter-target="item" data-tags="<%= project.tags %> <%= project.role %>" data-action="click->modal#openCase" data-id="<%= project.id %>" class="bg-brand-surface dark:bg-[#13171F] rounded-2xl border border-brand-tinta/10 dark:border-white/10 hover:border-[#003CA5]/50 dark:hover:border-[#003CA5]/70 transition-all duration-300 cursor-pointer flex flex-col justify-between group overflow-hidden hover:shadow-2xl">
            
            <!-- Imagem em Destaque Nítido (Topo do Card com Aspect-Ratio Fixo 16:10) -->
            <div class="relative w-full aspect-[16/10] bg-neutral-100 dark:bg-[#07090E] overflow-hidden">
              <% if project.image.attached? %>
                <%= image_tag project.image, class: "absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 pointer-events-none", loading: "lazy" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-neutral-600 text-xs font-mono">Sem Imagem</div>
              <% end %>

              <!-- Badges Flutuantes sobre a imagem -->
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="text-[11px] font-mono text-white bg-black/70 backdrop-blur-md px-3 py-1 rounded-full border border-white/10 shadow-sm">
                  <%= project.period %>
                </span>
              </div>

              <% if project.role.present? %>
                <div class="absolute top-3 right-3">
                  <span class="text-[11px] font-mono text-[#5B8EFF] bg-[#0B0D10]/85 backdrop-blur-md px-3 py-1 rounded-full border border-[#003CA5]/30 font-semibold shadow-sm">
                    <%= project.role %>
                  </span>
                </div>
              <% end %>
            </div>

            <!-- Conteúdo Textual Abaixo da Imagem -->
            <div class="p-6 sm:p-7 flex flex-col justify-between flex-1">
              <div>
                <h3 class="text-xl font-bold text-brand-tinta dark:text-white mb-2 group-hover:text-[#003CA5] dark:group-hover:text-[#5B8EFF] transition-colors flex items-center justify-between">
                  <span><%= project.title %></span>
                  <svg class="w-4 h-4 text-neutral-400 group-hover:text-[#003CA5] dark:group-hover:text-[#5B8EFF] group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </h3>

                <% if project.tagline.present? %>
                  <p class="text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-300 mb-3">
                    <%= project.tagline %>
                  </p>
                <% end %>

                <% if project.summary.present? %>
                  <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mb-5 line-clamp-2">
                    <%= project.summary %>
                  </p>
                <% end %>
              </div>

              <div>
                <!-- Tags -->
                <div class="flex flex-wrap gap-1.5 mb-5">
                  <% (project.tags || "").split(',').first(4).each do |tag| %>
                    <span class="px-2.5 py-1 rounded-md bg-brand-fundo dark:bg-[#0B0D10] text-[10px] font-mono text-neutral-600 dark:text-neutral-400 border border-brand-tinta/5 dark:border-white/5">
                      <%= tag.strip %>
                    </span>
                  <% end %>
                </div>

                <!-- Rodapé do Card -->
                <div class="pt-4 border-t border-brand-tinta/5 dark:border-white/5 flex items-center justify-between text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] font-semibold">
                  <span><%= t('work.viewCase', default: 'Read Case Study') %></span>
                  <span class="text-neutral-400 dark:text-neutral-500 font-normal"><%= project.client %></span>
                </div>
              </div>
            </div>

          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
