<!-- Case Studies Section -->
<section id="work" class="py-20 md:py-28 bg-[#F5F8FF] dark:bg-[#0A101C] border-y border-[#003CA5]/10 w-full">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Title Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] uppercase tracking-widest mb-3">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          <span><%= t('work.eyebrow', default: 'Selected Portfolio') %></span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight">
          <%= t('work.title', default: 'Case Studies') %>
        </h2>
        <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base max-w-xl mt-2">
          <%= t('work.subtitle', default: 'A selection of products where design strategy and behavioral insights drove measurable business impact.') %>
        </p>
      </div>

      <!-- Filter Chips (Mock for now or Stimulus controlled) -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-2 md:pb-0 font-mono text-xs scrollbar-none">
        <% ['All', 'Product Design', 'UX/UI', 'Brand Strategy', 'E-Commerce'].each do |filter| %>
          <button class="px-3.5 py-1.5 rounded-full whitespace-nowrap transition-all border <%= filter == 'All' ? 'bg-[#003CA5] text-white border-[#003CA5] font-semibold shadow-md' : 'bg-brand-surface dark:bg-[#13171F] text-brand-tinta/70 dark:text-neutral-400 border-brand-tinta/10 dark:border-white/10 hover:bg-brand-tinta hover:text-brand-surface dark:hover:bg-white/10 dark:hover:text-white' %>">
            <%= filter %>
          </button>
        <% end %>
      </div>
    </div>

    <% spotlight_project = @case_studies.find(&:is_spotlight) || @case_studies.first %>
    <% if spotlight_project %>
      <!-- 1. SPOTLIGHT CASE STUDY -->
      <div class="mb-12">
        <div class="bg-brand-surface dark:bg-[#13171F] rounded-3xl border border-[#003CA5]/30 overflow-hidden shadow-2xl relative card-border-glow group">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            <!-- Left Content Column -->
            <div class="lg:col-span-7 p-8 sm:p-10 flex flex-col justify-between">
              <div>
                <!-- Spotlight Badge -->
                <div class="flex items-center gap-3 mb-6">
                  <span class="px-3 py-1 rounded-full bg-[#003CA5]/10 border border-[#003CA5]/30 text-xs font-mono text-[#003CA5] font-bold flex items-center gap-1.5">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                    <%= t('work.spotlightBadge', default: 'Featured Spotlight') %>
                  </span>
                  <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
                    <%= spotlight_project.period %>
                  </span>
                </div>

                <h3 class="text-2xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight mb-3 group-hover:text-[#003CA5] transition-colors">
                  <%= spotlight_project.title %>
                </h3>

                <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 font-medium mb-4">
                  <%= spotlight_project.tagline %>
                </p>

                <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-8">
                  <%= spotlight_project.summary %>
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2 mb-8">
                  <% (spotlight_project.tags || "").split(',').each do |tag| %>
                    <span class="px-2.5 py-1 rounded-md bg-brand-fundo dark:bg-[#0B0D10] text-[11px] font-mono text-neutral-700 dark:text-neutral-300 border border-brand-tinta/5 dark:border-white/5">
                      <%= tag.strip %>
                    </span>
                  <% end %>
                </div>
              </div>

              <!-- Deep-Dive CTA -->
              <div>
                <a href="#modal" data-action="click->modal#openCase" data-id="<%= spotlight_project.id %>" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-xl bg-[#003CA5] hover:bg-[#002361] text-white font-semibold text-xs uppercase font-mono tracking-wider transition-all shadow-lg hover:shadow-[#003CA5]/25 group/btn">
                  <span><%= t('work.viewCase', default: 'Read Case Study') %></span>
                  <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
              </div>
            </div>

            <!-- Right Image / Mockup Column -->
            <div class="lg:col-span-5 relative bg-brand-fundo dark:bg-[#0B0D10] border-t lg:border-t-0 lg:border-l border-brand-tinta/5 dark:border-white/5 min-h-[320px] lg:min-h-full flex flex-col justify-between p-6 sm:p-8 overflow-hidden">
              <div class="absolute inset-0 bg-cover bg-center opacity-40 group-hover:scale-105 group-hover:opacity-60 transition-all duration-700 pointer-events-none" style="background-image: url('<%= url_for(spotlight_project.image) if spotlight_project.image.attached? %>')"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-brand-surface dark:from-[#0B0D10] via-brand-surface/60 dark:via-[#0B0D10]/60 to-transparent pointer-events-none"></div>

              <!-- Top Badge Overlay -->
              <div class="relative z-10 flex justify-end">
                <span class="px-3 py-1 rounded-full bg-brand-surface dark:bg-[#13171F]/90 backdrop-blur-md border border-brand-tinta/10 dark:border-white/10 text-[11px] font-mono text-neutral-700 dark:text-neutral-300">
                  Role: <%= spotlight_project.role %>
                </span>
              </div>

              <!-- Bottom Behavioral Highlights Card -->
              <div class="relative z-10 bg-brand-surface dark:bg-[#13171F]/90 backdrop-blur-md p-5 rounded-2xl border border-brand-tinta/10 dark:border-white/10 shadow-xl">
                <div class="flex items-center gap-2 text-xs font-mono text-purple-400 font-bold mb-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                  <span><%= t('work.behavioralEdge', default: 'Behavioral Edge') %></span>
                </div>
                <p class="text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed">
                  "<%= spotlight_project.behavioral_insight %>"
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. SECONDARY PROJECTS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @case_studies.reject { |cs| cs.id == spotlight_project.id }.each do |project| %>
          <div class="bg-brand-surface dark:bg-[#13171F] p-7 rounded-2xl border border-brand-tinta/5 dark:border-white/5 hover:border-brand-tinta/15 dark:border-white/15 transition-all cursor-pointer flex flex-col justify-between group relative overflow-hidden card-border-glow hover:shadow-xl">
            <div class="absolute inset-0 bg-cover bg-center opacity-30 group-hover:opacity-50 group-hover:scale-105 transition-all duration-700 pointer-events-none" style="background-image: url('<%= url_for(project.image) if project.image.attached? %>')"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-brand-surface dark:from-[#13171F] via-brand-surface/80 dark:via-[#13171F]/80 to-transparent pointer-events-none"></div>
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
                  <%= project.period %>
                </span>
                <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 bg-brand-fundo dark:bg-[#0B0D10] px-2.5 py-1 rounded-full border border-brand-tinta/5 dark:border-white/5">
                  <%= project.role %>
                </span>
              </div>

              <h3 class="text-xl font-bold text-brand-tinta dark:text-white mb-2 group-hover:text-[#003CA5] transition-colors flex items-center justify-between">
                <span><%= project.title %></span>
                <svg class="w-4 h-4 text-neutral-500 dark:text-neutral-400 group-hover:text-[#003CA5] group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </h3>

              <p class="text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-4">
                <%= project.tagline %>
              </p>

              <p class="text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed mb-6 line-clamp-3">
                <%= project.summary %>
              </p>
            </div>

            <div class="relative z-10 mt-6">
              <div class="flex flex-wrap gap-1.5 mb-6">
                <% (project.tags || "").split(',').each do |tag| %>
                  <span class="px-2 py-0.5 rounded bg-brand-fundo dark:bg-[#0B0D10] text-[10px] font-mono text-neutral-600 dark:text-neutral-400 border border-brand-tinta/5 dark:border-white/5">
                    <%= tag.strip %>
                  </span>
                <% end %>
              </div>

              <div class="pt-4 border-t border-brand-tinta/5 dark:border-white/5 flex items-center justify-between text-xs font-mono text-[#003CA5] font-semibold">
                <span><%= t('work.viewCase', default: 'Read Case Study') %></span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
