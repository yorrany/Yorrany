<!-- CV & Credentials Section (Compact & Visual Timeline) -->
<section id="cv" class="py-20 md:py-28 bg-brand-fundo dark:bg-[#0B0D10] border-b border-brand-tinta/5 dark:border-white/5 relative w-full" data-controller="tabs reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6" data-reveal-target="item">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] uppercase tracking-widest font-bold mb-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span><%= t('cv.eyebrow', default: 'Trajetória & Credenciais') %></span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight font-serif">
          <%= t('cv.title', default: 'Experiência & Formação') %>
        </h2>
        <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base max-w-2xl mt-2">
          <%= t('cv.subtitle', default: '20 anos de liderança em design de produto, arquitetura front-end e pesquisa comportamental.') %>
        </p>
      </div>

      <a href="/cv/yorrany_cv_<%= I18n.locale.to_s.split('-').first %>.pdf?t=<%= Time.now.to_i %>#view=FitH" target="_blank" data-turbo="false" class="flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-neutral-900 hover:bg-neutral-800 text-white dark:bg-white dark:hover:bg-neutral-100 dark:text-neutral-900 font-mono text-xs font-bold transition-all shadow-md hover:shadow-lg border border-neutral-800 dark:border-white/20 w-auto self-start md:self-auto group">
        <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform text-white dark:text-neutral-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        <span><%= t('cv.downloadPdf', default: 'Download CV Oficial (PDF)') %></span>
      </a>
    </div>

    <!-- CV View Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10 font-mono text-xs" data-reveal-target="item">
      <button data-tabs-target="tab" data-action="click->tabs#switch" class="flex items-center gap-2 px-5 py-2.5 rounded-full border text-xs font-mono font-bold transition-all whitespace-nowrap bg-[#003CA5] hover:bg-[#002361] text-white shadow-lg border-[#003CA5]">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        <span class="pointer-events-none"><%= t('cv.expTab', default: 'Experiência') %> (<%= @experiences.size %>)</span>
      </button>

      <button data-tabs-target="tab" data-action="click->tabs#switch" class="flex items-center gap-2 px-5 py-2.5 rounded-full border text-xs font-mono font-bold transition-all whitespace-nowrap text-neutral-600 dark:text-neutral-400 hover:text-brand-tinta dark:hover:text-white hover:bg-brand-tinta/5 dark:hover:bg-white/10 border-brand-tinta/10 dark:border-white/10 bg-brand-surface dark:bg-[#13171F]">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="pointer-events-none"><%= t('cv.certTab', default: 'Certificações') %> (<%= @certifications.size %>)</span>
      </button>

      <button data-tabs-target="tab" data-action="click->tabs#switch" class="flex items-center gap-2 px-5 py-2.5 rounded-full border text-xs font-mono font-bold transition-all whitespace-nowrap text-neutral-600 dark:text-neutral-400 hover:text-brand-tinta dark:hover:text-white hover:bg-brand-tinta/5 dark:hover:bg-white/10 border-brand-tinta/10 dark:border-white/10 bg-brand-surface dark:bg-[#13171F]">
        <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path></svg>
        <span class="pointer-events-none"><%= t('cv.academicTab', default: 'Formação') %> (<%= @academic_bgs.size %>)</span>
      </button>
    </div>

    <!-- TAB 1: COMPACT CAREER TIMELINE -->
    <div data-tabs-target="panel" class="space-y-4 max-w-4xl mx-auto">
      <% @experiences.each_with_index do |exp, index| %>
        <div class="bg-brand-surface dark:bg-[#13171F] p-5 sm:p-6 rounded-2xl border border-brand-tinta/10 dark:border-white/10 hover:border-[#003CA5]/40 dark:hover:border-[#5B8EFF]/40 transition-all card-border-glow shadow-sm" data-controller="expandable" data-reveal-target="item">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-[#003CA5]/10 dark:bg-white/5 text-[#003CA5] dark:text-[#5B8EFF] font-mono font-bold text-xs flex items-center justify-center shrink-0">
                <%= exp.company.to_s.first(2).upcase %>
              </span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-brand-tinta dark:text-white leading-snug">
                  <%= exp.role %>
                </h3>
                <div class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">
                  <%= exp.company %> • <span class="font-mono text-[11px]"><%= exp.location %></span>
                </div>
              </div>
            </div>

            <span class="text-xs font-mono font-bold text-[#003CA5] dark:text-[#5B8EFF] bg-brand-fundo dark:bg-[#0B0D10] px-3 py-1 rounded-full border border-brand-tinta/5 dark:border-white/5 self-start sm:self-auto shrink-0">
              <%= exp.period %>
            </span>
          </div>

          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed mt-2">
            <%= exp.summary %>
          </p>

          <!-- Expandable Highlights & Skills -->
          <div data-expandable-target="content" class="hidden pt-4 mt-4 border-t border-brand-tinta/5 dark:border-white/5 space-y-3">
            <% if exp.highlights.present? %>
              <div class="space-y-1.5 font-mono text-xs">
                <% exp.highlights.split('||').each do |h| %>
                  <div class="flex items-start gap-2 text-neutral-700 dark:text-neutral-300">
                    <svg class="w-3.5 h-3.5 text-[#003CA5] dark:text-[#5B8EFF] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    <span><%= h.strip %></span>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% if exp.skills.present? %>
              <div class="flex flex-wrap gap-1.5 pt-2">
                <% exp.skills.split(',').each do |skill| %>
                  <span class="px-2.5 py-1 rounded-md bg-brand-fundo dark:bg-[#0B0D10] text-[10px] font-mono text-neutral-700 dark:text-neutral-300 border border-brand-tinta/5 dark:border-white/5">
                    <%= skill.strip %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>

          <% if exp.highlights.present? || exp.skills.present? %>
            <button data-action="click->expandable#expand" data-expandable-target="toggleText" class="mt-3 text-xs font-mono font-bold text-[#003CA5] dark:text-[#5B8EFF] hover:underline focus:outline-none inline-flex items-center gap-1">
              Ver detalhes &amp; stack ▾
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- TAB 2: CERTIFICATIONS GRID -->
    <div data-tabs-target="panel" class="hidden space-y-4 max-w-4xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% @certifications.each do |cert| %>
          <div class="bg-brand-surface dark:bg-[#13171F] p-5 rounded-2xl border border-brand-tinta/10 dark:border-white/10 hover:border-[#003CA5]/40 dark:hover:border-[#5B8EFF]/40 transition-all card-border-glow flex flex-col justify-between" data-reveal-target="item">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[10px] font-mono text-neutral-500 bg-brand-fundo dark:bg-[#0B0D10] px-2.5 py-0.5 rounded-full border border-brand-tinta/5 dark:border-white/5">
                  <%= cert.category %>
                </span>
                <span class="text-xs font-mono font-bold text-[#003CA5] dark:text-[#5B8EFF]">
                  <%= cert.year %>
                </span>
              </div>

              <h3 class="text-sm sm:text-base font-bold text-brand-tinta dark:text-white leading-snug mb-1">
                <%= cert.title %>
              </h3>

              <div class="text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-3">
                <%= cert.issuer %>
              </div>
            </div>

            <div class="pt-3 border-t border-brand-tinta/5 dark:border-white/5 flex items-center justify-between text-xs font-mono">
              <% if cert.credential_code.present? %>
                <span class="text-[10px] text-emerald-500 font-bold">ID: <%= cert.credential_code %></span>
              <% else %>
                <span class="text-[10px] text-neutral-400">Certificado Oficial</span>
              <% end %>

              <% if cert.image.attached? %>
                <button data-action="click->modal#openCert" data-cert-id="<%= cert.id %>" data-url="<%= url_for(cert.image) %>" data-title="<%= cert.title %>" data-is-image="<%= cert.image.content_type.start_with?('image/').to_s %>" data-credential-code="<%= cert.credential_code %>" data-credential-url="<%= cert.credential_url %>" class="text-xs font-bold text-[#003CA5] dark:text-[#5B8EFF] hover:underline flex items-center gap-1">
                  Visualizar Doc ↗
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- TAB 3: ACADEMIC BACKGROUND -->
    <div data-tabs-target="panel" class="hidden space-y-6 max-w-4xl mx-auto">
      <% @academic_bgs.each do |bg| %>
        <div class="bg-brand-surface dark:bg-[#13171F] p-6 sm:p-8 rounded-3xl border border-brand-tinta/10 dark:border-white/10 card-border-glow space-y-4" data-reveal-target="item">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#003CA5]/10 text-[#003CA5] dark:text-[#5B8EFF] flex items-center justify-center shrink-0 font-bold">
                🎓
              </div>
              <div>
                <span class="px-2.5 py-0.5 rounded-full bg-[#003CA5]/10 text-[#003CA5] dark:text-[#5B8EFF] text-[10px] font-mono font-bold">
                  <%= bg.period %>
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-tinta dark:text-white mt-1">
                  <%= bg.degree %>
                </h3>
                <div class="text-sm font-semibold text-neutral-600 dark:text-neutral-400">
                  <%= bg.institution %> • <span class="font-mono text-xs"><%= bg.field_of_study %></span>
                </div>
              </div>
            </div>
          </div>

          <% if bg.thesis.present? %>
            <div class="p-4 rounded-2xl bg-brand-fundo dark:bg-[#0B0D10] border border-brand-tinta/5 dark:border-white/5 text-xs sm:text-sm">
              <span class="font-mono text-[10px] text-[#003CA5] dark:text-[#5B8EFF] uppercase font-bold block mb-1">Pesquisa &amp; Tese Publicada</span>
              <p class="text-neutral-700 dark:text-neutral-300 italic">"<%= bg.thesis %>"</p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</section>
