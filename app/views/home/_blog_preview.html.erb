<% if @posts.any? %>
<section class="py-20 md:py-28 bg-[#F5F8FF] dark:bg-[#07090E] w-full border-t border-[#003CA5]/10" data-controller="reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6" data-reveal-target="item">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-tinta dark:text-white tracking-tight mb-2"><%= t('blog.latest_insights', default: 'Artigos Recentes') %></h2>
        <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base"><%= t('blog.latest_subtitle', default: 'Reflexões sobre design de produto, comportamento e tecnologia.') %></p>
      </div>
      <a href="<%= blog_index_path %>" class="inline-flex items-center gap-2 text-sm font-bold font-mono text-[#003CA5] dark:text-[#5B8EFF] hover:underline transition-colors">
        <%= t('blog.read_blog', default: 'Ler o Blog') %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% @posts.each do |post| %>
        <a href="<%= blog_path(post.slug) %>" class="group block bg-brand-surface dark:bg-[#13171F] p-6 rounded-3xl border border-brand-tinta/10 dark:border-white/10 hover:border-[#003CA5]/50 transition-all hover:shadow-2xl hover:-translate-y-1 overflow-hidden card-border-glow" data-reveal-target="item">
          <% if post.cover_image.attached? %>
            <div class="aspect-video w-full rounded-2xl overflow-hidden mb-6 relative">
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent z-10 pointer-events-none"></div>
              <%= image_tag post.cover_image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 relative z-0" %>
            </div>
          <% end %>
          <time class="text-xs font-mono text-[#003CA5] dark:text-[#5B8EFF] mb-2 block"><%= post.published_at ? (l(post.published_at.to_date, format: :long) rescue post.published_at.strftime("%B %d, %Y")) : "" %></time>
          <h3 class="text-2xl font-bold text-brand-tinta dark:text-white mb-3 group-hover:text-[#003CA5] transition-colors"><%= post.title %></h3>
          <p class="text-neutral-600 dark:text-neutral-400 line-clamp-2"><%= post.excerpt %></p>
        </a>
      <% end %>
    </div>
  </div>
</section>
<% end %>
