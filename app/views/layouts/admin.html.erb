<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Yorrany Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#0B0D10] text-neutral-400 font-sans antialiased min-h-screen flex flex-col">
    <!-- Navbar -->
    <header class="bg-[#13171F] border-b border-white/10 p-4 flex justify-between items-center shrink-0">
      <div class="text-white text-xl font-bold flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-[#003CA5] flex items-center justify-center text-white text-sm">Y</div>
        Yorrany Admin
      </div>
      <div>
        <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "text-sm text-neutral-400 hover:text-white transition-colors" %>
      </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
      <!-- Main Content -->
      <main class="flex-1 overflow-y-auto p-4 md:p-8 relative">
        <%= yield %>
        <turbo-frame id="modal"></turbo-frame>
      </main>
    </div>
  </body>
</html>
