<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
    <div class="bg-[#13171F] border border-white/10 rounded-xl max-w-2xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
      <div class="p-4 border-b border-white/10 flex justify-between items-center bg-[#13171F]">
        <h3 class="text-xl font-bold text-white"><%= title %></h3>
        <%= link_to "✕", admin_path, data: { turbo_frame: "_top" }, class: "text-neutral-500 hover:text-white" %>
      </div>
      <div class="p-6 overflow-y-auto flex-1">
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
