<div data-controller="scroll-to-top" class="fixed bottom-6 right-6 z-50">
  <button data-scroll-to-top-target="button" 
          data-action="click->scroll-to-top#scrollToTop"
          class="opacity-0 translate-y-4 pointer-events-none transition-all duration-300 ease-out bg-brand-surface/80 dark:bg-brand-dark-surface/80 backdrop-blur-md border border-brand-tinta/10 dark:border-white/10 hover:border-brand-primaria dark:hover:border-brand-dark-primaria p-3 rounded-full shadow-lg hover:shadow-brand-primaria/20 group focus:outline-none focus:ring-2 focus:ring-brand-primaria"
          aria-label="Scroll to top">
    <svg class="w-5 h-5 text-brand-tinta/70 dark:text-brand-dark-tinta/70 group-hover:text-brand-primaria dark:group-hover:text-brand-dark-primaria transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
    </svg>
  </button>
</div>
