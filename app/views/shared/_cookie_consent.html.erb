<!-- Cookie Consent (GDPR) -->
<div id="cookie-consent" data-controller="cookie-consent" class="fixed bottom-6 left-6 z-[60] w-[calc(100%-3rem)] sm:max-w-[360px] bg-brand-surface dark:bg-[#13171F] border border-[#003CA5]/10 dark:border-white/10 rounded-2xl shadow-2xl p-5 hidden pointer-events-auto transition-opacity duration-300">
  <div class="flex flex-col gap-3.5">
    <div class="flex items-start justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#003CA5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        <h3 class="text-[13px] font-bold text-brand-tinta dark:text-white leading-none">Privacidade & Cookies</h3>
      </div>
    </div>
    
    <p class="text-[11px] text-neutral-600 dark:text-neutral-400 leading-relaxed">
      No espírito de máxima transparência (GDPR): usamos apenas cookies essenciais e analíticos anônimos para entregar e otimizar esta experiência.
    </p>
    
    <div class="flex flex-col gap-2 mt-1">
      <button data-action="click->cookie-consent#acceptAll" class="w-full py-2 bg-[#003CA5] hover:bg-[#002361] text-white text-[12px] font-semibold rounded-lg transition-colors">
        Aceitar Todos
      </button>
      <div class="flex gap-2">
        <button data-action="click->cookie-consent#rejectAll" class="w-1/2 py-2 bg-neutral-100 hover:bg-neutral-200 dark:bg-[#1C212B] dark:hover:bg-[#252B36] text-brand-tinta dark:text-white text-[12px] font-semibold rounded-lg transition-colors border border-transparent dark:border-white/5">
          Apenas Essenciais
        </button>
        <button data-action="click->cookie-consent#manage" class="w-1/2 py-2 bg-transparent hover:bg-neutral-50 dark:hover:bg-[#1C212B] border border-brand-tinta/10 dark:border-white/10 text-brand-tinta dark:text-white text-[12px] font-semibold rounded-lg transition-colors">
          Preferências
        </button>
      </div>
    </div>
  </div>
</div>
