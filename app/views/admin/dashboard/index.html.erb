<div class="max-w-4xl mx-auto space-y-8">
  <div class="flex justify-between items-end border-b border-white/10 pb-4">
    <h1 class="text-3xl font-bold text-white">Perfil</h1>
  </div>

  <!-- Case Studies -->
  <section class="bg-[#13171F] rounded-xl border border-white/10 overflow-hidden">
    <div class="p-6 border-b border-white/10 flex justify-between items-center">
      <h2 class="text-xl font-semibold text-white">Estudos de Caso</h2>
      <%= link_to "+ Adicionar", new_admin_case_study_path, data: { turbo_frame: "modal" }, class: "text-sm text-[#003CA5] hover:text-[#3d6cff] font-medium" %>
    </div>
    <div id="case_studies" class="divide-y divide-white/10 p-6 flex flex-col gap-4">
      <% @case_studies.each do |case_study| %>
        <%= render "admin/case_studies/case_study", case_study: case_study %>
      <% end %>
    </div>
  </section>

  <!-- Experience -->
  <section class="bg-[#13171F] rounded-xl border border-white/10 overflow-hidden">
    <div class="p-6 border-b border-white/10 flex justify-between items-center">
      <h2 class="text-xl font-semibold text-white">Experiência</h2>
      <%= link_to "+ Adicionar", new_admin_experience_item_path, data: { turbo_frame: "modal" }, class: "text-sm text-[#003CA5] hover:text-[#3d6cff] font-medium" %>
    </div>
    <div id="experience_items" class="divide-y divide-white/10 p-6 flex flex-col gap-4">
      <% @experience_items.each do |experience_item| %>
        <%= render "admin/experience_items/experience_item", experience_item: experience_item %>
      <% end %>
    </div>
  </section>

  <!-- Certifications -->
  <section class="bg-[#13171F] rounded-xl border border-white/10 overflow-hidden">
    <div class="p-6 border-b border-white/10 flex justify-between items-center">
      <h2 class="text-xl font-semibold text-white">Certificações</h2>
      <%= link_to "+ Adicionar", new_admin_certification_path, data: { turbo_frame: "modal" }, class: "text-sm text-[#003CA5] hover:text-[#3d6cff] font-medium" %>
    </div>
    <div id="certifications" class="divide-y divide-white/10 p-6 flex flex-col gap-4" data-controller="sortable" data-sortable-url-value="<%= reorder_admin_certifications_path %>">
      <% @certifications.each do |certification| %>
        <%= render "admin/certifications/certification", certification: certification %>
      <% end %>
    </div>
  </section>

  <!-- Academic Backgrounds -->
  <section class="bg-[#13171F] rounded-xl border border-white/10 overflow-hidden">
    <div class="p-6 border-b border-white/10 flex justify-between items-center">
      <h2 class="text-xl font-semibold text-white">Formação Acadêmica</h2>
      <%= link_to "+ Adicionar", new_admin_academic_background_path, data: { turbo_frame: "modal" }, class: "text-sm text-[#003CA5] hover:text-[#3d6cff] font-medium" %>
    </div>
    <div id="academic_backgrounds" class="divide-y divide-white/10 p-6 flex flex-col gap-4">
      <% @academic_backgrounds.each do |academic_background| %>
        <%= render "admin/academic_backgrounds/academic_background", academic_background: academic_background %>
      <% end %>
    </div>
  </section>
</div>

<!-- Base Modal Frame -->
<%= turbo_frame_tag "modal" %>
