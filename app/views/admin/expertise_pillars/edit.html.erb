<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="bg-[#13171F] border border-white/10 rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6 shadow-2xl">
      <div class="flex justify-between items-center pb-4 border-b border-white/10 mb-6">
        <h2 class="text-xl font-bold text-white">Editar Pilar de Atuação</h2>
        <%= link_to "✕", admin_path, data: { turbo_frame: "_top" }, class: "text-neutral-400 hover:text-white" %>
      </div>
      <%= render "form", expertise_pillar: @expertise_pillar %>
    </div>
  </div>
<% end %>
