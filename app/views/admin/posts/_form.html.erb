<%= form_with(model: [:admin, post], class: "space-y-4", multipart: true) do |f| %>
  <% if post.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-3 rounded-lg text-sm">
      <ul>
        <% post.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Título do Artigo", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_field :title, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :slug, "Slug (URL amigável - opcional)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :slug, placeholder: "gerado-automaticamente", class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :published_at, "Data de Publicação", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.datetime_local_field :published_at, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div>
    <%= f.label :excerpt, "Resumo / Subtítulo", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_area :excerpt, rows: 2, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div>
    <%= f.label :content, "Conteúdo Completo (Markdown / HTML)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_area :content, rows: 8, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5] font-mono text-sm" %>
  </div>

  <div>
    <%= f.label :cover_image, "Imagem de Capa (Upload)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.file_field :cover_image, class: "w-full text-sm text-neutral-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-white/5 file:text-white hover:file:bg-white/10" %>
  </div>

  <div class="pt-4 border-t border-white/10 flex justify-end gap-2">
    <%= link_to "Cancelar", admin_path, data: { turbo_frame: "_top" }, class: "px-4 py-2 rounded-lg text-sm font-medium text-neutral-400 hover:text-white hover:bg-white/5" %>
    <%= f.submit "Salvar e Traduzir com IA", class: "px-4 py-2 rounded-lg text-sm font-medium bg-[#003CA5] text-white hover:bg-[#3d6cff] cursor-pointer" %>
  </div>
<% end %>
