<%= turbo_frame_tag academic_background do %>
  <div class="flex gap-4">
    <div class="w-16 h-16 bg-[#1A1F2B] rounded-lg border border-white/5 flex-shrink-0 flex justify-center items-center overflow-hidden">
      <% if academic_background.image.attached? %>
        <%= image_tag academic_background.image, class: "w-full h-full object-cover" %>
      <% else %>
        <span class="text-neutral-500 text-xs">Sem Imagem</span>
      <% end %>
    </div>
    <div class="flex-1">
      <div class="flex justify-between">
        <h3 class="text-white font-semibold"><%= academic_background.degree %></h3>
        <div class="flex gap-2">
          <%= link_to "Editar", edit_admin_academic_background_path(academic_background), data: { turbo_frame: "modal" }, class: "text-xs text-neutral-400 hover:text-white" %>
          <%= button_to "Excluir", admin_academic_background_path(academic_background), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "text-xs text-red-500 hover:text-red-400" %>
        </div>
      </div>
      <p class="text-sm text-neutral-400"><%= academic_background.institution %> • <%= academic_background.period %></p>
      <p class="text-xs text-neutral-500 mt-1"><%= academic_background.field_of_study %></p>
    </div>
  </div>
<% end %>
