<%= turbo_frame_tag certification, data: { sortable_id: certification.id }, class: "group/item" do %>
  <div class="flex gap-4 items-start py-2">
    <!-- Handle -->
    <div class="cursor-grab text-neutral-600 hover:text-white flex items-center shrink-0 pt-4" data-sortable-handle>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
    </div>
    
    <% if certification.image.attached? %>
      <div class="relative w-20 h-20 sm:w-28 sm:h-20 bg-[#0B0D10] rounded-xl border border-white/10 flex items-center justify-center overflow-hidden shrink-0">
        <% if certification.image.representable? %>
          <%= image_tag certification.image.representation(resize_to_fill: [200, 150]), class: "w-full h-full object-cover" %>
        <% else %>
          <a href="<%= url_for(certification.image) %>" target="_blank" class="w-full h-full flex flex-col justify-center items-center hover:bg-white/5 transition-colors">
            <svg class="w-6 h-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            <span class="text-[10px] text-neutral-500 mt-1 font-mono">Doc</span>
          </a>
        <% end %>
      </div>
    <% else %>
      <div class="relative w-20 h-20 sm:w-28 sm:h-20 bg-[#0B0D10] rounded-xl border border-white/10 flex items-center justify-center overflow-hidden shrink-0">
        <span class="text-neutral-500 text-[10px] font-mono"><%= certification.issuer.to_s.first(3).upcase.presence || "CERT" %></span>
      </div>
    <% end %>

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap justify-between items-start gap-2 mb-1">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-white font-semibold truncate"><%= certification.title %></h3>
          <% if certification.year.present? %>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-white/5 text-neutral-400 border border-white/10">
              <%= certification.year %>
            </span>
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to "Editar", edit_admin_certification_path(certification), data: { turbo_frame: "modal" }, class: "text-xs font-mono text-[#5B8EFF] hover:underline" %>
          <%= button_to "Excluir", admin_certification_path(certification), method: :delete, data: { turbo_confirm: "Tem certeza que deseja remover esta certificação?" }, class: "text-xs font-mono text-red-500 hover:text-red-400 cursor-pointer" %>
        </div>
      </div>

      <p class="text-xs text-neutral-400"><%= certification.issuer %> • <%= certification.category %></p>

      <% if certification.credential_code.present? %>
        <div class="mt-1.5 flex items-center gap-2 font-mono text-[11px]">
          <span class="text-neutral-400 bg-white/5 px-2 py-0.5 rounded border border-white/5">ID: <%= certification.credential_code %></span>
          <% if certification.credential_url.present? %>
            <a href="<%= certification.credential_url %>" target="_blank" class="text-[#5B8EFF] hover:underline flex items-center gap-1">
              Ver credencial ↗
            </a>
          <% end %>
        </div>
      <% end %>

      <div class="flex flex-wrap items-center justify-between gap-2 mt-2 pt-2 border-t border-white/5">
        <span class="text-[11px] font-mono text-neutral-500"><%= certification.skills %></span>
        <%= render "admin/shared/translation_badges", record: certification, translate_path: translate_admin_certification_path(certification) %>
      </div>
    </div>
  </div>
<% end %>
