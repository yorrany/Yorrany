<%= turbo_frame_tag certification, data: { sortable_id: certification.id }, class: "group/item" do %>
  <div class="flex gap-4">
    <!-- Handle -->
    <div class="cursor-grab text-neutral-600 hover:text-white flex items-center shrink-0" data-sortable-handle>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
    </div>
    
    <% if certification.image.attached? %>
      <div class="relative w-24 h-24 sm:w-40 sm:h-40 bg-[#0B0D10] rounded-xl border border-white/5 flex items-center justify-center overflow-hidden shrink-0 cursor-pointer group-hover:border-white/20 transition-colors" data-action="click->modal#openCert" data-url="<%= url_for(certification.image) %>" data-title="<%= certification.title %>" data-is-image="<%= certification.image.content_type.start_with?('image/').to_s %>">
        <% if certification.image.representable? %>
          <%= image_tag certification.image.representation(resize_to_fill: [400, 300]), class: "w-full h-full object-cover" %>
        <% else %>
          <a href="<%= url_for(certification.image) %>" target="_blank" class="w-full h-full flex flex-col justify-center items-center hover:bg-white/5 transition-colors">
            <svg class="w-6 h-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            <span class="text-[10px] text-neutral-500 mt-1">Doc</span>
          </a>
        <% end %>
      </div>
    <% else %>
      <div class="relative w-24 h-24 sm:w-40 sm:h-40 bg-[#0B0D10] rounded-xl border border-white/5 flex items-center justify-center overflow-hidden shrink-0">
        <span class="text-neutral-500 text-xs">Sem Imagem</span>
      </div>
    <% end %>
    <div class="flex-1">
      <div class="flex justify-between">
        <h3 class="text-white font-semibold"><%= certification.title %></h3>
        <div class="flex gap-2">
          <%= link_to "Editar", edit_admin_certification_path(certification), data: { turbo_frame: "modal" }, class: "text-xs text-neutral-400 hover:text-white" %>
          <%= button_to "Excluir", admin_certification_path(certification), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "text-xs text-red-500 hover:text-red-400" %>
        </div>
      </div>
      <p class="text-sm text-neutral-400"><%= certification.issuer %> • <%= certification.category %></p>

      <% if certification.document_title.present? || certification.document_caption.present? %>
        <p class="text-xs text-neutral-500 mt-1">
          <span class="font-medium text-neutral-400"><%= certification.document_title %></span> 
          <%= "- #{certification.document_caption}" if certification.document_caption.present? %>
        </p>
      <% end %>

      <% if certification.credential_code.present? %>
        <div class="mt-2 flex items-center gap-2">
          <span class="text-xs font-mono text-neutral-500 bg-white/5 px-2 py-1 rounded">ID: <%= certification.credential_code %></span>
          <% if certification.credential_url.present? %>
            <a href="<%= certification.credential_url %>" target="_blank" class="text-xs text-[#003CA5] hover:underline flex items-center gap-1">
              Exibir credencial
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          <% end %>
        </div>
      <% end %>

      <% if certification.skills.present? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% certification.skills.split(',').map(&:strip).reject(&:blank?).each do |skill| %>
            <span class="text-xs font-medium text-white bg-white/5 border border-white/10 px-2.5 py-1 rounded-full">
              <%= skill %>
            </span>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
<% end %>
