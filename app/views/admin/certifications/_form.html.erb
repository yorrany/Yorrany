<%= form_with(model: [:admin, certification], class: "space-y-4", multipart: true) do |f| %>
  <% if certification.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-3 rounded-lg text-sm">
      <ul>
        <% certification.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Título", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_field :title, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :issuer, "Emissor", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :issuer, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :category, "Categoria", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :category, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div>
    <%= f.label :skills, "Soft/Hard Skills (separadas por vírgula)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_field :skills, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]", placeholder: "Ex: Ruby, Rails, Liderança" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :credential_code, "Código da Credencial", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :credential_code, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :credential_url, "URL da Credencial", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :credential_url, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div class="border-t border-white/10 pt-4 mt-4">
    <h4 class="text-sm font-medium text-neutral-300 mb-2">Documento (Upload)</h4>
    <div class="space-y-4">
      <div>
        <%= f.label :image, "Arquivo/Imagem do Certificado", class: "block text-xs font-medium text-neutral-400 mb-1" %>
        <%= f.file_field :image, class: "w-full text-sm text-neutral-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-white/5 file:text-white hover:file:bg-white/10" %>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :document_title, "Título do Documento", class: "block text-xs font-medium text-neutral-400 mb-1" %>
          <%= f.text_field :document_title, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
        </div>
        <div>
          <%= f.label :document_caption, "Legenda do Documento", class: "block text-xs font-medium text-neutral-400 mb-1" %>
          <%= f.text_field :document_caption, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
        </div>
      </div>
    </div>
  </div>

  <div class="pt-4 border-t border-white/10 flex justify-end gap-2">
    <%= link_to "Cancelar", admin_path, data: { turbo_frame: "_top" }, class: "px-4 py-2 rounded-lg text-sm font-medium text-neutral-400 hover:text-white hover:bg-white/5" %>
    <%= f.submit "Salvar", class: "px-4 py-2 rounded-lg text-sm font-medium bg-[#003CA5] text-white hover:bg-[#3d6cff] cursor-pointer" %>
  </div>
<% end %>
