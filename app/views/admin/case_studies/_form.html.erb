<%= form_with(model: [:admin, case_study], class: "space-y-4", multipart: true) do |f| %>
  <% if case_study.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-3 rounded-lg text-sm">
      <ul>
        <% case_study.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex items-center justify-between p-4 bg-[#13171F] border border-white/10 rounded-lg">
    <div class="flex items-center gap-3">
      <%= f.check_box :is_spotlight, class: "w-4 h-4 rounded border-white/20 text-[#003CA5] focus:ring-[#003CA5] bg-[#0B0D10]" %>
      <div>
        <%= f.label :is_spotlight, "Destacar na Página Inicial (Spotlight)", class: "text-sm font-semibold text-white cursor-pointer" %>
        <p class="text-xs text-neutral-400">Exibe este projeto no bloco de destaque principal no topo da Home.</p>
      </div>
    </div>
    <div class="w-40">
      <%= f.label :accent_color, "Cor de Destaque", class: "block text-xs font-medium text-neutral-400 mb-1" %>
      <%= f.text_field :accent_color, placeholder: "#003CA5", class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div>
    <%= f.label :title, "Título", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_field :title, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div>
    <%= f.label :tagline, "Slogan (Tagline)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_field :tagline, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :client, "Cliente", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :client, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :period, "Período", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :period, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :role, "Seu Papel", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :role, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :tags, "Tags (separadas por vírgula)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :tags, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div>
    <%= f.label :summary, "Resumo", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_area :summary, rows: 3, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div>
    <%= f.label :full_description, "Descrição Completa", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_area :full_description, rows: 5, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :challenge, "O Desafio", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_area :challenge, rows: 4, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :solution, "A Solução", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_area :solution, rows: 4, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div>
    <%= f.label :behavioral_insight, "Behavioral Insight", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_area :behavioral_insight, rows: 3, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div data-controller="image-preview">
      <%= f.label :image, "Imagem de Capa (Principal)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.file_field :image, data: { action: "change->image-preview#preview", image_preview_target: "input" }, class: "w-full text-sm text-neutral-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-white/5 file:text-white hover:file:bg-white/10 mb-2" %>
      
      <div data-image-preview-target="container" class="<%= case_study.image.attached? ? '' : 'hidden' %> mt-2">
        <p class="text-xs text-neutral-500 mb-2">Preview (Nova seleção substitui a atual):</p>
        <div data-image-preview-target="preview" class="grid grid-cols-2 gap-2">
          <% if case_study.image.attached? %>
            <div class="relative group rounded-lg overflow-hidden border border-white/10">
              <%= image_tag case_study.image, class: "w-full h-32 object-cover" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <%= f.label :gallery_images, "Adicionar Novas Imagens à Galeria (Múltiplas)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.file_field :gallery_images, multiple: true, class: "w-full text-sm text-neutral-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-white/5 file:text-white hover:file:bg-white/10 mb-2" %>
      
      <% if case_study.persisted? && case_study.gallery_images.attached? %>
        <div class="mt-4 p-3 bg-[#0B0D10] border border-white/10 rounded-xl">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono text-neutral-400">Imagens Atuais da Galeria (<%= case_study.gallery_images.count %>)</span>
            <span class="text-[10px] text-neutral-500">Passe o mouse e clique no ícone para excluir</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-h-60 overflow-y-auto pr-1">
            <% case_study.gallery_images.attachments.each do |att| %>
              <div id="gallery_attachment_<%= att.id %>" class="relative group rounded-lg overflow-hidden border border-white/10 bg-[#13171F]">
                <%= image_tag att, class: "w-full h-24 object-cover", loading: "lazy" %>
                <div class="absolute inset-0 bg-black/70 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-2">
                  <%= link_to purge_attachment_admin_case_study_path(case_study, attachment_id: att.id),
                              data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir esta imagem da galeria?" },
                              class: "p-2 rounded-full bg-red-600/90 hover:bg-red-600 text-white shadow-lg transition-transform hover:scale-110",
                              title: "Excluir imagem" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="pt-4 border-t border-white/10 flex justify-end gap-2">
    <%= link_to "Cancelar", admin_path, data: { turbo_frame: "_top" }, class: "px-4 py-2 rounded-lg text-sm font-medium text-neutral-400 hover:text-white hover:bg-white/5" %>
    <%= f.submit "Salvar", class: "px-4 py-2 rounded-lg text-sm font-medium bg-[#003CA5] text-white hover:bg-[#3d6cff] cursor-pointer" %>
  </div>
<% end %>
