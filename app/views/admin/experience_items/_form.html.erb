<%= form_with(model: [:admin, experience_item], class: "space-y-4", multipart: true) do |f| %>
  <% if experience_item.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-3 rounded-lg text-sm">
      <ul>
        <% experience_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :role, "Cargo / Função", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :role, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :company, "Empresa", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :company, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div>
      <%= f.label :type_name, "Tipo (ex: Full-Time / Consultoria)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :type_name, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :period, "Período (ex: 2022 - Presente)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :period, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
    <div>
      <%= f.label :location, "Localização (ex: Remoto, Portugal / Brasil)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :location, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    </div>
  </div>

  <div>
    <%= f.label :summary, "Resumo da Atuação", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_area :summary, rows: 3, class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div>
    <%= f.label :highlights, "Destaques / Realizações (Separe os tópicos com '||')", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_area :highlights, rows: 3, placeholder: "Liderança de Design System || Redução de 40% no tempo de dev || Arquitetura front-end", class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
    <p class="text-[11px] text-neutral-500 mt-1 font-mono">Dica: use duas barras verticais '||' para dividir em bullets.</p>
  </div>

  <div>
    <%= f.label :skills, "Stack / Competências (separadas por vírgula)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.text_field :skills, placeholder: "Figma, Design Tokens, React, Tailwind, Rails", class: "w-full bg-[#0B0D10] border border-white/10 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-[#003CA5]" %>
  </div>

  <div>
    <%= f.label :image, "Logo da Empresa (Upload)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= f.file_field :image, class: "w-full text-sm text-neutral-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-white/5 file:text-white hover:file:bg-white/10" %>
  </div>

  <div class="pt-4 border-t border-white/10 flex justify-end gap-2">
    <%= link_to "Cancelar", admin_path, data: { turbo_frame: "_top" }, class: "px-4 py-2 rounded-lg text-sm font-medium text-neutral-400 hover:text-white hover:bg-white/5" %>
    <%= f.submit "Salvar e Traduzir com IA", class: "px-4 py-2 rounded-lg text-sm font-medium bg-[#003CA5] text-white hover:bg-[#3d6cff] cursor-pointer" %>
  </div>
<% end %>
