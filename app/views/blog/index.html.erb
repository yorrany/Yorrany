<%= render 'home/navbar' %>
<main class="py-24 md:py-32 bg-brand-fundo dark:bg-brand-dark-fundo min-h-screen">
  <div class="max-w-4xl mx-auto px-6 sm:px-8">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-brand-tinta dark:text-white mb-4">Blog</h1>
      <p class="text-neutral-600 dark:text-neutral-400 text-lg">Insights, thoughts, and writings on design and engineering.</p>
    </header>

    <div class="space-y-12">
      <% @posts.each do |post| %>
        <article class="group relative flex flex-col sm:flex-row gap-8 items-start bg-brand-surface dark:bg-[#13171F] p-6 rounded-3xl border border-brand-tinta/5 dark:border-white/5 hover:border-brand-primaria/50 transition-all hover:shadow-xl hover:-translate-y-1">
          <% if post.cover_image.attached? %>
            <div class="w-full sm:w-1/3 aspect-[4/3] rounded-xl overflow-hidden flex-shrink-0">
              <%= image_tag post.cover_image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
            </div>
          <% end %>
          <div class="flex-1 flex flex-col justify-center">
            <time class="text-xs font-mono text-[#003CA5] mb-2 block"><%= post.published_at.strftime("%B %d, %Y") %></time>
            <h2 class="text-2xl font-bold text-brand-tinta dark:text-white mb-3 group-hover:text-[#003CA5] transition-colors">
              <a href="<%= blog_path(post.slug) %>" class="after:absolute after:inset-0">
                <%= post.title %>
              </a>
            </h2>
            <p class="text-neutral-600 dark:text-neutral-400 line-clamp-3">
              <%= post.excerpt %>
            </p>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</main>
<%= render 'home/contact_footer' %>
